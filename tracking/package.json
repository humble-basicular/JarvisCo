{
  "name": "jarvisweb-proof-tracking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --tsconfig=tsconfig.json --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/worker.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:check": "wrangler deploy --dry-run --outdir dist/wrangler"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
