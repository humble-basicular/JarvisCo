---
/* Header for the client site's simple pages (/aciu, /privatumo-politika): name back to the home page + phone. */
import { initials, t } from './content';

interface Props { business: string; phone: string; tel: string | null; logo?: string }
const { business, phone, tel, logo } = Astro.props;
---
<header class="hs-top">
  <div class="hs-wrap hs-top__bar">
    <a class="hs-logo" href="/">{logo ? <img class="hs-logo__mark hs-logo__mark--img" src={logo} width="44" height="44" alt="" /> : <span class="hs-logo__mark" aria-hidden="true">{initials(business)}</span>}<span class="hs-logo__text"><span class="hs-logo__name">{business}</span></span></a>
    <a class="hs-top__call" href={tel ? `tel:${tel}` : undefined} data-cta="cta_call">
      <svg class="hs-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5 9 3l1.6 4.4-2 1.4a12 12 0 0 0 6.6 6.6l1.4-2L21 15l-.5 2.4A3 3 0 0 1 17.6 20 14.6 14.6 0 0 1 4 6.4a3 3 0 0 1 2.6-2.9z"/></svg>
      <span class="hs-top__label">{t.call}</span>
      <span class="hs-top__num">{phone}</span>
    </a>
  </div>
</header>
