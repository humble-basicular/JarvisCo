---
/* The heating business site, filled from SiteData (design report §4 wireframe).
   Two design directions are under review (2026-10-16): A "Editorial" (default,
   what the generator builds) and B "Livery". Both share the form, the details
   sections, footer and mobile bar (parts/), and the page script (client.js).
   A section renders only when its facts are in the data: photos, standout,
   qualifications, prices, reviews and hours are never invented.
   `mode="preview"`: call buttons jump to the form, nothing dials, and the form
   is inert (no names, method get). `mode="live"`: tel:/sms: links send cta
   beacons and the inquiry form posts to the Worker (offer-v2 spec §3). */
import clientScript from './client.js?raw';
import SiteA from './SiteA.astro';
import SiteB from './SiteB.astro';
import type { Direction, LiveSite, Mode, SiteData } from './types';

interface Props { data: SiteData; mode: Mode; site?: LiveSite; direction?: Direction }
const { data, mode, site, direction = 'a' } = Astro.props;
---
{direction === 'b' ? <SiteB data={data} mode={mode} site={site} /> : <SiteA data={data} mode={mode} site={site} />}
<script is:inline set:html={clientScript}></script>
