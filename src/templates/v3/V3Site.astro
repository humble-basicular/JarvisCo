---
/* Template v3 page (design plan 2026-10-20, "Template v3: section order"):
   header → hero with quote form → trust strip → [town block] → about → services →
   process → work gallery → reviews (+ Google profile links) → prices → FAQ → areas + map → photo CTA → footer.
   Everything comes from SiteData + the `v3` block (content.ts); the theme card picks the
   look (hero/services layout, font, divider, badge). Absent data → the part is not shown.
   Client preview call links dial directly; demo call links remain inert. The form is inert
   (no field names, nothing leaves the page), outbound profile links are plain text. */
import type { SiteData, TownLink, TownPage } from '../heating/types';
import { toE164 } from '../heating/content';
import QuoteForm from './parts/QuoteForm.astro';
import { LINK_ICON, LINK_LABEL, EMPHASIS_MIN_WIDTH, areaMap, galleryPhotos, serviceIcon, workPhotos, type V3Input, type V3Photo, type V3LiveSite } from './content';
import Badge from './parts/Badge.astro';
import ServiceContent from './parts/ServiceContent.astro';
import { pageForService, serviceHref } from './service-pages.mjs';
import Divider from './parts/Divider.astro';
import Icon from './parts/Icon.astro';
import { ICON, type IconName } from './icons';

interface Props {
  data: Omit<SiteData, 'photos'> & { photos: V3Photo[] };
  v3: V3Input;
  towns: TownLink[];
  /** Home page city (town pages re-point data.city to the town). */
  base: string;
  /** Town (GEO) page: swaps the H1 place, adds the town block. */
  town?: TownPage;
  /** Href of the home page (brand link on town pages). */
  home?: string;
  /** Labelled demo with DI illustrations: footer DI line. */
  demo?: boolean;
  site?: V3LiveSite;
  service?: import('./content').V3ServicePage;
}
const { data, v3, towns, base, town, home = '#pradzia', demo = false, site, service } = Astro.props;
const serviceBase = site ? '' : `/perziura/${data.slug}`;
const detail = (name: string) => { const p = pageForService(v3.servicePages, name); return p ? serviceHref(p.slug, serviceBase) : undefined; };
const theme = v3.theme;
const phone = toE164(data.phone);
const tel = !demo && phone ? `tel:${phone}` : '#uzklausa';
const d = theme.divider;
const P = data.photos;
const at = (i: number | undefined, fallback: number) => P[i ?? fallback] ?? P[fallback % P.length] ?? P[0];
const selectedServicePhoto = service && P[service.photoIndexes?.[0] ?? -1];
const hero = service ? (selectedServicePhoto && selectedServicePhoto.width >= EMPHASIS_MIN_WIDTH.background ? selectedServicePhoto : undefined) : at(v3.photo?.hero, 0);
const aboutPhoto = at(v3.photo?.about, 4);
const faqPhoto = at(v3.photo?.faq, 2);
const ctaPhoto = at(v3.photo?.cta, 3);
const reviewsPhoto = at(v3.photo?.reviews ?? v3.photo?.hero, 0);
const pins = (v3.photo?.pins ?? [1, 2, 3]).map((i) => P[i]).filter((p) => p && !p.ai).slice(0, 3);
const gallery = galleryPhotos(P);
const works = workPhotos(P); // every real job photo, for the lightbox
const services = data.services.map((s) => (typeof s === 'string' ? { name: s, text: '' } : { name: s.name, text: s.text ?? '' }));
const year = new Date().getFullYear();
const baseLine = v3.baseLine ?? `${base} ir aplink`;
/* The client's own logo (input `logo`) replaces the generated badge only when v3.clientLogo opts in. */
const clientLogo = v3.clientLogo && data.logo?.src;
const logoSize = { width: v3.clientLogo?.width, height: v3.clientLogo?.height };
/* A wide logo+name lockup already shows the name: don't repeat it as text beside it. */
const lockup = !!clientLogo && !v3.clientLogo?.showName && v3.clientLogo!.width > v3.clientLogo!.height;
/* Two-tone wordmark for camel-case names ("MesElektra" → Mes + accent Elektra). */
const nameSplit = data.business.match(/^(\p{Ll}*\p{Lu}\p{Ll}+)(\p{Lu}\p{L}+)$/u);
const h1 = town
  ? (v3.h1.tail ? { ...v3.h1, tail: town.loc } : { ...v3.h1, hot: town.loc, tail: undefined })
  : v3.h1;
const pill = v3.pill ?? data.areas.slice(0, 4).join(' · ');
const menuNav = () => [
  ...nav,
  ...(!demo && !service ? [{ href: '#atsiliepimai', label: 'Atsiliepimai' }] : []),
  ...(!service && data.faq?.length ? [{ href: '#duk', label: 'D.U.K.' }] : []),
];
const nav = service ? [{ href: '#aprasymas', label: 'Apie paslaugą' }, { href: '#kitos-paslaugos', label: 'Paslaugos' }, { href: '#vietoves', label: 'Kur dirbame' }] : [
  { href: '#paslaugos', label: 'Paslaugos' },
  { href: '#eiga', label: 'Kaip dirbame' },
  { href: '#darbai', label: 'Darbai' },
  ...(data.prices?.length ? [{ href: '#kainos', label: 'Kainos' }] : []),
  { href: '#vietoves', label: 'Kur dirbame' },
];
const map = areaMap(base, towns.map((t) => t.name), town?.name);
/* Use Google's public share/embed URL for an identified business, never a private address.
   Town pages retain their area map. Live embeds still require the existing consent action. */
const businessMap = !town && v3.map?.embedUrl;
const mapQuery = town ? `${town.name}, Lietuva` : v3.map?.query ?? `${base}, Lietuva`;
const mapTitle = businessMap ? data.business : mapQuery;
const mapLink = businessMap && v3.gbp?.url ? v3.gbp.url : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const mapZoom = (!town && v3.map?.zoom) || (town ? 12 : map?.zoom ?? 11);
const mapSrc = businessMap || `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=${mapZoom}&hl=lt&output=embed`;
const nearby = (town ? town.places : data.areas.filter((a) => !towns.some((t) => t.name === a) && a !== base)).slice(0, 8);
const MONTHS = ['sausio', 'vasario', 'kovo', 'balandžio', 'gegužės', 'birželio', 'liepos', 'rugpjūčio', 'rugsėjo', 'spalio', 'lapkričio', 'gruodžio'];
const ltDate = (iso?: string) => { const m = iso?.match(/^(\d{4})-(\d{2})-(\d{2})/); return m ? `${m[1]} m. ${MONTHS[+m[2] - 1]} ${+m[3]} d.` : undefined; };
const reviews = data.reviews ?? [];
const gbp = v3.gbp ?? {};
const reviewPlatform = gbp.platform || 'Google';
const rateFlow = gbp.reviewFlow === 'rating-dialog' && !!gbp.reviewUrl && !!data.email;
const img = (p: V3Photo, sizes: string, extra: Record<string, string> = {}) => ({ src: p.src, srcset: p.srcset, sizes: p.srcset ? sizes : undefined, width: p.width, height: p.height, decoding: 'async', ...extra });
// Badge glyphs without a 24 px line icon (rope) fall back to the shield in the hero pill.
const pillIcon: IconName = theme.logo.glyph in ICON ? theme.logo.glyph as IconName : 'shield';
---
<a class="v3-skip" href="#uzklausa">Pereiti prie užklausos formos</a>

<div class="v3-util">
  <div class="v3-wrap v3-util__bar">
    <p><Icon name="pin" />{baseLine}</p>
    {data.hours && <p class="v3-util__hours"><Icon name="clock" />{data.hours}</p>}
    {data.email ? <p class="v3-util__mail"><Icon name="mail" />{data.email}</p> : <p class="v3-util__mail"><Icon name="phone" />{data.phone}</p>}
  </div>
</div>

<header class="v3-top">
  <div class="v3-wrap v3-top__bar">
    <a class:list={["v3-brand", v3.largeWordmark && "v3-brand--large", v3.clientLogo?.showName && "v3-brand--named", lockup && "v3-brand--lockup"]} href={home} aria-label={`${data.business}, pradžia`}>
      {clientLogo ? (
        <>
          <img class="v3-brand__logo" src={clientLogo} alt={data.business} {...logoSize} />
          {/* A client logo stands alone in the header: no tagline beside it (Matas 2026-10-26: "atrodo labai blogai"). */}
          {v3.clientLogo?.showName && <span class="v3-brand__text"><span class="v3-brand__name">{nameSplit ? <>{nameSplit[1]}<span class="v3-brand__two">{nameSplit[2]}</span></> : data.business}</span></span>}
        </>
      ) : (
        <>
          <Badge name={data.business} theme={theme} uid="b-head" size={64} />
          <span class="v3-brand__text"><span class="v3-brand__name">{nameSplit ? <>{nameSplit[1]}<span class="v3-brand__two">{nameSplit[2]}</span></> : data.business}</span>{!v3.hideTagline && <span class="v3-brand__line">{theme.logo.line}</span>}</span>
        </>
      )}
    </a>
    <nav class="v3-nav" aria-label="Svetainės skyriai">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="v3-top__ctas">
      <a class="v3-top__phone" href={tel} aria-label={`Skambinti ${data.phone}`}><span class="v3-top__phone-ico"><Icon name="phone" /></span><span><span class="v3-top__phone-label">Skambinkite</span><span class="v3-top__phone-num">{data.phone}</span></span></a>
      <a class="v3-btn v3-btn--accent v3-top__quote" href="#uzklausa" data-quote>Gauti kainą</a>
      <button class="v3-top__menu" type="button" data-menu-open aria-haspopup="dialog" aria-controls="v3-menu" aria-label="Atidaryti meniu"><Icon name="menu" /></button>
    </div>
  </div>
</header>

<main id="pradzia">
  <section class:list={['v3-hero', `v3-hero--${theme.hero}`]} aria-labelledby="v3-h1">
    <>{hero && <img class="v3-hero__bg" {...img(hero, '100vw')} alt="" fetchpriority="high" />}</>
    <div class="v3-wrap v3-hero__grid">
      <div class="v3-hero__copy">
        <p class="v3-pill"><Icon name={pillIcon} />{service ? data.areas.join(' · ') : town ? `${town.name} · ${town.places.slice(0, 3).join(' · ')}` : pill}</p>
        <h1 id="v3-h1" class="v3-h1">{service ? service.heading : <>{h1.lead}{' '}<br /><span class="v3-hot">{h1.hot}</span>{h1.tail && ` ${h1.tail}`}</>}</h1>
        <p class="v3-hero__lead">{service?.lead ?? data.lead}</p>
        <div class="v3-hero__ctas">
          <a class="v3-btn v3-btn--accent v3-btn--lg" href={tel}><Icon name="phone" />Skambinti {data.phone}</a>
          <a class="v3-btn v3-btn--ghost v3-btn--lg" href="#uzklausa" data-quote>Gauti kainą</a>
        </div>
        {!service && <ul class="v3-checks">
          {v3.heroChecks.map((c) => <li><Icon name="check" />{c}</li>)}
        </ul>}
        {!service && theme.hero === 'panel' && pins.length > 0 && (
          <figure class="v3-pins">
            <ul>{pins.map((p) => <li><img {...img(p, '10rem')} alt={p.alt ?? ''} loading="lazy" /></li>)}</ul>
            <figcaption><Icon name="camera" />Tikros mūsų darbų nuotraukos</figcaption>
          </figure>
        )}
      </div>

      <div class="v3-quote" id="uzklausa">
        <QuoteForm business={data.business} phone={data.phone} theme={theme} v3={v3} tel={tel} serviceName={service?.heading} uid="b-form"  badge={!clientLogo} clientLogo={clientLogo && v3.clientLogo?.formBadge ? { src: clientLogo, ...logoSize } : undefined} site={site} />
      </div>
    </div>
    <Divider shape={d} from="photo" to="accent" />
  </section>

  {service ? <ServiceContent data={data} service={service} pages={v3.servicePages ?? []} towns={towns} base={serviceBase} home={home} /> : <>
  <section class="v3-trust" aria-label="Kodėl mes">
    <ul class="v3-wrap v3-trust__list" style={`--n:${v3.trust.length}`}>
      {v3.trust.map((t) => (
        <li><span class="v3-trust__ico"><Icon name={t.icon} /></span><span><strong>{t.title}</strong><span>{t.text}</span></span></li>
      ))}
    </ul>
  </section>
  <Divider shape={d} from="accent" to="white" flip />

  {town && (
    <section class="v3-sec v3-town" id="aptarnavimas" aria-labelledby="v3-town">
      <div class="v3-wrap v3-town__grid">
        <div>
          <p class="v3-kicker">{town.label ?? town.name}</p>
          <h2 id="v3-town" class="v3-h2">{town.heading}</h2>
          <p class="v3-town__text">{town.text}</p>
          {town.note && <p class="v3-town__note"><Icon name="verified" />{town.note}</p>}
          <p class="v3-town__back"><a href={home}><Icon name="arrow" class="v3-town__back-ico" />Visos paslaugos ir vietovės</a></p>
        </div>
        <aside class="v3-town__card">
          {town.distance && <p class="v3-town__dist"><Icon name="pin" />{town.distance}</p>}
          {!!town.services?.length && (
            <>
              <p class="v3-town__h">Dažni darbai {town.loc}</p>
              <ul class="v3-town__list">{town.services.map((s) => <li><span class="v3-ticks__ico"><Icon name={serviceIcon(s)} /></span>{s}</li>)}</ul>
            </>
          )}
          {town.places.length > 0 && (
            <>
              <p class="v3-town__h">Važiuojame ir į</p>
              <ul class="v3-town__places">{town.places.map((p) => <li>{p}</li>)}</ul>
            </>
          )}
        </aside>
      </div>
    </section>
  )}

  <section class="v3-sec v3-about" aria-labelledby="v3-about">
    <div class="v3-wrap v3-about__grid">
      <div class="v3-about__media">
        <img {...img(aboutPhoto, '(min-width: 64rem) 34rem, 92vw')} alt={aboutPhoto.alt ?? ''} loading="lazy" />
        <div class="v3-about__stamp">
          {clientLogo ? <span class="v3-logo-plate v3-logo-plate--stamp"><img src={clientLogo} alt="" {...logoSize} /></span> : <Badge name={data.business} theme={theme} uid="b-about" size={96} />}
          <p>{(v3.stamp?.title || !lockup) && <strong>{v3.stamp?.title ?? data.business}</strong>}<span>{v3.stamp?.text ?? baseLine}</span></p>
        </div>
      </div>
      <div class="v3-about__copy">
        <p class="v3-kicker">Apie mus</p>
        <h2 id="v3-about" class="v3-h2">{v3.aboutTitle}</h2>
        {data.about && <p class="v3-about__text">{data.about}</p>}
        {!!v3.aboutChecks?.length && (
          <ul class="v3-ticks">
            {v3.aboutChecks.map((c) => <li><span class="v3-ticks__ico"><Icon name="check" /></span>{c}</li>)}
          </ul>
        )}
        {!!v3.links?.length && (
          <div class="v3-find">
            <p>Rasite mus:</p>
            <ul>{v3.links.map((l) => <li>{l.url ? <a href={l.url} rel="noopener" target="_blank"><Icon name={LINK_ICON[l.kind]} />{LINK_LABEL[l.kind]}</a> : <><Icon name={LINK_ICON[l.kind]} />{LINK_LABEL[l.kind]}</>}</li>)}</ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="v3-sec v3-sec--paper" id="paslaugos" aria-labelledby="v3-services">
    <div class="v3-wrap">
      <header class="v3-head">
        <p class="v3-kicker">Paslaugos</p>
        <h2 id="v3-services" class="v3-h2">Ką atliekame</h2>
      </header>
      {theme.services === 'tiles' ? (
        <ul class="v3-tiles">
          {services.map((s, i) => {
            const p = at(v3.tilePhotos?.[i], i);
            return (
              <li class:list={['v3-tile', detail(s.name) && 'v3-tile--detail']}>
                <a href={detail(s.name) ?? '#uzklausa'} data-quote={!detail(s.name) ? true : undefined}>
                  <img {...img(p, '(min-width: 64rem) 24rem, (min-width: 40rem) 46vw, 92vw')} alt="" loading="lazy" />
                  <span class="v3-tile__body">
                    <span class="v3-tile__name">{s.name}</span>
                    <span class="v3-tile__text">{s.text}</span>
                  </span>
                  <span class="v3-tile__go"><Icon name="arrow" /></span>
                </a>
                {detail(s.name) && <a class="v3-service-quote" href="#uzklausa" data-quote>Aptarti darbą<Icon name="arrow" /></a>}
              </li>
            );
          })}
          <li class="v3-tile v3-tile--cta">
            <div>
              <Icon name="phone" class="v3-tile__big" />
              <p class="v3-tile__name">Neradote reikiamos paslaugos?</p>
              <p class="v3-tile__text">Paskambinkite – aptarsime, kuo galime padėti.</p>
              <a class="v3-btn v3-btn--white" href={tel}>{data.phone}</a>
            </div>
          </li>
        </ul>
      ) : (
        <ul class="v3-cards">
          {services.map((s) => (
            <li class="v3-card">
              <span class="v3-card__ico"><Icon name={serviceIcon(s.name)} /></span>
              <h3 class="v3-card__name">{detail(s.name) ? <a href={detail(s.name)}>{s.name}</a> : s.name}</h3>
              {s.text && <p class="v3-card__text">{s.text}</p>}
              {detail(s.name) && <a class="v3-card__go" href={detail(s.name)}>Apie paslaugą<Icon name="arrow" /></a>}
              <a class="v3-card__go" href="#uzklausa" data-quote>Aptarti darbą<Icon name="arrow" /></a>
            </li>
          ))}
          <li class="v3-card v3-card--cta">
            <Icon name="phone" class="v3-tile__big" />
            <p class="v3-card__name">Neradote reikiamos paslaugos?</p>
            <p class="v3-card__text">Paskambinkite – aptarsime, kuo galime padėti.</p>
            <a class="v3-btn v3-btn--white" href={tel}>{data.phone}</a>
          </li>
        </ul>
      )}
      {!!data.brands?.length && (
        <div class="v3-brands">
          <p>Taisome ir prižiūrime:</p>
          <ul>{data.brands.map((b) => <li>{b}</li>)}</ul>
        </div>
      )}
    </div>
  </section>
  <Divider shape={d} from="paper" to="base" />

  <section class={`v3-sec v3-steps v3-steps--${theme.process ?? 'line'}`} id="eiga" aria-labelledby="v3-process">
    <div class="v3-wrap">
      <header class="v3-head v3-head--center">
        <p class="v3-kicker v3-kicker--hi">Kaip dirbame</p>
        <h2 id="v3-process" class="v3-h2">{v3.stepsTitle ?? 'Nuo skambučio iki atlikto darbo'}</h2>
      </header>
      <ol class="v3-steps__list" style={`--n:${v3.steps.length}`}>
        {v3.steps.map((s, i) => (
          theme.process === 'chevron' ? (
            <li>
              <span class="v3-steps__ico"><Icon name={s.icon} /><span class="v3-steps__n">{i + 1}</span></span>
              <span class="v3-steps__stem" aria-hidden="true"></span>
              <div class="v3-steps__tag"><h3>{s.title}</h3></div>
              <p>{s.text}</p>
            </li>
          ) : (
            <li>
              <span class="v3-steps__ico"><Icon name={s.icon} /><span class="v3-steps__n">{i + 1}</span></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          )
        ))}
      </ol>
      <p class="v3-steps__cta"><a class="v3-btn v3-btn--accent v3-btn--lg" href="#uzklausa" data-quote>Pradėti nuo 1 žingsnio</a></p>
    </div>
  </section>
  <Divider shape={d} from="base" to="white" flip />

  <section class="v3-sec v3-gallery" id="darbai" aria-labelledby="v3-works">
    <div class="v3-wrap">
      <header class="v3-head v3-head--row">
        <div>
          <p class="v3-kicker">Darbai</p>
          <h2 id="v3-works" class="v3-h2">Atlikti darbai</h2>
        </div>
        {v3.galleryNote && <p class="v3-gallery__note">{v3.galleryNote}</p>}
      </header>
      <ul class="v3-masonry">
        {gallery.map((p, i) => (
          <li class={`v3-masonry__${i}`}>
            <button class="v3-masonry__open" type="button" data-lb-open={i} aria-label={`Atidaryti nuotrauką ${i + 1} iš ${works.length}`}>
              <img {...img(p, i === 0 ? '(min-width: 64rem) 36rem, 92vw' : '(min-width: 64rem) 18rem, 46vw')} alt={p.alt ?? ''} loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
      {works.length > gallery.length && (
        <p class="v3-gallery__all"><button class="v3-btn v3-btn--accent" type="button" data-lb-open="0"><Icon name="camera" />Žiūrėti visas nuotraukas ({works.length})</button></p>
      )}
    </div>
  </section>

  {/* "All photos" lightbox: every real job photo. Closed <dialog> = display:none, so its lazy images load only once it opens. */}
  {gallery.length > 0 && (
    <dialog class="v3-lb" data-lb aria-label="Atlikti darbai – visos nuotraukos">
      <p class="v3-lb__count" data-lb-count aria-live="polite">1 / {works.length}</p>
      <button class="v3-lb__x" type="button" data-lb-close aria-label="Uždaryti"><Icon name="close" /></button>
      <ul class="v3-lb__track" data-lb-track tabindex="0">
        {works.map((p, i) => (
          <li><img {...img(p, '100vw')} alt={p.alt || `Atliktas darbas ${i + 1}`} loading="lazy" /></li>
        ))}
      </ul>
      <button class="v3-lb__nav v3-lb__nav--prev" type="button" data-lb-prev aria-label="Ankstesnė nuotrauka"><Icon name="arrow" /></button>
      <button class="v3-lb__nav v3-lb__nav--next" type="button" data-lb-next aria-label="Kita nuotrauka"><Icon name="arrow" /></button>
    </dialog>
  )}

  {/* Client sites only: the labelled demo carries no testimonials, not even the pending Google box.
     Real quotes only; stars only when the source shows a rating (review.rating). */}
  {!demo && (reviews.length > 0 || gbp.url || gbp.reviewUrl || !v3.hidePendingGoogle) && (
    <section class="v3-reviews" id="atsiliepimai" aria-labelledby="v3-reviews">
      <img class="v3-reviews__bg" {...img(reviewsPhoto, '100vw')} alt="" loading="lazy" />
      <div class="v3-wrap">
        <header class="v3-reviews__head">
          <div>
            <p class="v3-reviews__kicker">Ką sako klientai</p>
            <h2 id="v3-reviews" class="v3-h2">Atsiliepimai</h2>
          </div>
          <span class="v3-reviews__rule" aria-hidden="true"></span>
          <a class="v3-btn v3-btn--white" href="#uzklausa" data-quote>Susisiekti<Icon name="arrow" /></a>
        </header>
        {reviews.length > 0 && (
          <div class="v3-reviews__slider">
            <ul class:list={['v3-reviews__list', reviews.length < 3 && `is-${reviews.length}`]} data-reviews tabindex="0" aria-label="Atsiliepimai">
              {reviews.map((r) => (
                <li class="v3-rcard">
