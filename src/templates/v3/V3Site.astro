<div class="v3-dock is-hidden" data-dock role="group" aria-label="Greiti veiksmai">
  <a class="v3-btn v3-btn--accent" href={tel}><Icon name="phone" />Skambinti</a>
  <a class="v3-btn v3-btn--white" href="#uzklausa" data-quote>Gauti kainą<Icon name="arrow" /></a>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-map-src]').forEach(function (button) {
      button.addEventListener('click', function () {
        var frame = document.createElement('iframe');
        frame.src = button.getAttribute('data-map-src');
        frame.title = button.getAttribute('data-map-title');
        frame.referrerPolicy = 'no-referrer';
        frame.allowFullscreen = true;
        button.parentElement.replaceWith(frame);
      });
    });
    document.querySelectorAll('[data-inert-form]').forEach(function (form) {
      form.addEventListener('submit', function (e) { e.preventDefault(); var n = form.querySelector('[data-inert-note]'); if (n) n.hidden = false; });
    });
    // Every "Gauti kainą" / "Aptarti darbą" link opens the focused quote dialog; without <dialog> it falls back to #uzklausa.
    var menu = document.querySelector('[data-menu]');
    var modal = document.querySelector('[data-quote-modal]');
    if (menu && typeof menu.showModal === 'function') {
      document.querySelectorAll('[data-menu-open]').forEach(function (b) {
        b.addEventListener('click', function () { menu.showModal(); document.documentElement.classList.add('v3-locked'); });
      });
      menu.addEventListener('click', function (e) {
        if (e.target === menu || e.target.closest('[data-menu-close]') || e.target.closest('[data-menu-link]')) menu.close();
      });
      menu.addEventListener('close', function () { if (!(modal && modal.open)) document.documentElement.classList.remove('v3-locked'); });
    }
    if (modal && typeof modal.showModal === 'function') {
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('[data-quote]');
        if (!a) return;
        e.preventDefault();
        if (menu && menu.open) menu.close();
        modal.showModal();
        document.documentElement.classList.add('v3-locked');
        var f = modal.querySelector('input:not([type=hidden]):not([tabindex="-1"])'); if (f) f.focus();
      });
      modal.addEventListener('click', function (e) { if (e.target === modal || e.target.closest('[data-quote-close]')) modal.close(); });
      modal.addEventListener('close', function () { document.documentElement.classList.remove('v3-locked'); });
    }
    // Work photo lightbox: opens at the clicked photo; swipe / arrows / keys move, Esc or × closes.
    var lb = document.querySelector('[data-lb]');
    if (lb) {
      var lbModal = typeof lb.showModal === 'function';
      var track = lb.querySelector('[data-lb-track]'), count = lb.querySelector('[data-lb-count]');
      var total = track.children.length;
      var at = function () { return Math.round(track.scrollLeft / (track.clientWidth || 1)); };
      var go = function (i, smooth) {
        i = Math.max(0, Math.min(total - 1, i));
        track.scrollTo({ left: i * track.clientWidth, behavior: smooth ? 'smooth' : 'instant' });
        count.textContent = (i + 1) + ' / ' + total;
      };
      // No <dialog> support: show the viewer inline below the gallery instead of as a modal.
      if (!lbModal) { lb.setAttribute('open', ''); lb.classList.add('v3-lb--inline'); }
      document.querySelectorAll('[data-lb-open]').forEach(function (b) {
        b.addEventListener('click', function () {
          if (lbModal) { lb.showModal(); document.documentElement.classList.add('v3-locked'); }
          else lb.scrollIntoView({ block: 'center' });
          go(+b.getAttribute('data-lb-open') || 0, false);
          track.focus({ preventScroll: true });
        });
      });
      lb.querySelector('[data-lb-prev]').addEventListener('click', function () { go(at() - 1, true); });
      lb.querySelector('[data-lb-next]').addEventListener('click', function () { go(at() + 1, true); });
      if (lbModal) {
        lb.querySelector('[data-lb-close]').addEventListener('click', function () { lb.close(); });
        lb.addEventListener('click', function (e) { if (e.target === lb || e.target.tagName === 'LI') lb.close(); });
        lb.addEventListener('close', function () { document.documentElement.classList.remove('v3-locked'); });
      }
      lb.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(at() - 1, true); }
        if (e.key === 'ArrowRight') { e.preventDefault(); go(at() + 1, true); }
      });
      track.addEventListener('scroll', function () { count.textContent = (at() + 1) + ' / ' + total; }, { passive: true });
    }
    // Review arrows: shown only while the cards overflow; disabled at either end.
    var list = document.querySelector('[data-reviews]');
    var nav = document.querySelector('[data-reviews-nav]');
    if (list && nav) {
      var prev = nav.querySelector('[data-reviews-prev]'), next = nav.querySelector('[data-reviews-next]');
      var sync = function () {
        var max = list.scrollWidth - list.clientWidth;
        nav.hidden = max < 2;
        prev.disabled = list.scrollLeft < 2;
        next.disabled = list.scrollLeft > max - 2;
      };
      prev.addEventListener('click', function () { list.scrollBy({ left: -list.clientWidth, behavior: 'smooth' }); });
      next.addEventListener('click', function () { list.scrollBy({ left: list.clientWidth, behavior: 'smooth' }); });
      list.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }
    // Mobile action bar: appears only after the hero buttons scroll away, hides again over the quote form.
    // Geometry check on load, scroll and resize (an observer alone misses instant anchor jumps).
    var dock = document.querySelector('[data-dock]');
    var heroCtas = document.querySelector('.v3-hero__ctas');
    var q = document.getElementById('uzklausa');
    if (dock && heroCtas) {
      var queued = false;
      var syncDock = function () {
        queued = false;
        var past = heroCtas.getBoundingClientRect().bottom < 0;
        var r = q && q.getBoundingClientRect();
        var overForm = !!r && r.top < innerHeight * 0.75 && r.bottom > innerHeight * 0.25;
        dock.classList.toggle('is-hidden', !past || overForm);
      };
      var queue = function () { if (!queued) { queued = true; requestAnimationFrame(syncDock); } };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      addEventListener('pageshow', queue);
      addEventListener('hashchange', queue);
      syncDock();
    }
  })();
</script>

{rateFlow && (
  <script is:inline>
    (function () {
      var d = document.querySelector('[data-rate]');
      var open = document.querySelector('[data-rate-open]');
      if (!d || !open || typeof d.showModal !== 'function') return;
      var rate = d.querySelector('[data-rate-step="rate"]');
      var priv = d.querySelector('[data-rate-form]');
      var radios = d.querySelectorAll('[data-rate-stars] input');
      var err = d.querySelector('[data-rate-err]');
      var ferr = d.querySelector('[data-rate-ferr]');
      var stars = d.querySelector('[data-rate-stars]');
      var value = 0;
      function paint(n) { radios.forEach(function (r, i) { r.parentElement.classList.toggle('is-on', i < n); }); }
      function focusH(root) { var h = root.querySelector('h2'); if (h) h.focus(); }
      function reset() { value = 0; radios.forEach(function (r) { r.checked = false; }); paint(0); err.hidden = true; ferr.hidden = true; priv.hidden = true; rate.hidden = false; d.querySelector('[data-rate-after]').hidden = true; }
      open.addEventListener('click', function (e) { e.preventDefault(); reset(); d.showModal(); document.documentElement.classList.add('v3-locked'); focusH(rate); });
      d.querySelector('[data-rate-close]').addEventListener('click', function () { d.close(); });
      d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
      d.addEventListener('close', function () { document.documentElement.classList.remove('v3-locked'); open.focus(); });
      radios.forEach(function (r, i) {
        r.addEventListener('change', function () { value = i + 1; paint(value); err.hidden = true; });
        r.parentElement.addEventListener('mouseenter', function () { paint(i + 1); });
      });
      stars.addEventListener('mouseleave', function () { paint(value); });
      d.querySelector('[data-rate-next]').addEventListener('click', function () {
        if (!value) { err.hidden = false; radios[0].focus(); return; }
        if (value >= 4) {
          var w = window.open(d.getAttribute('data-review-url'), '_blank', 'noopener');
          if (!w) window.location.assign(d.getAttribute('data-review-url'));
          d.close();
          return;
        }
        rate.hidden = true; priv.hidden = false; focusH(priv);
      });
      d.querySelector('[data-rate-back]').addEventListener('click', function () { priv.hidden = true; rate.hidden = false; focusH(rate); });
      priv.addEventListener('submit', function (e) {
        e.preventDefault();
        var msg = d.querySelector('#v3-rate-msg');
        if (!msg.value.trim()) { ferr.hidden = false; msg.focus(); return; }
        var email = d.querySelector('#v3-rate-email');
        if (email.value && !email.checkValidity()) { email.focus(); email.reportValidity(); return; }
        ferr.hidden = true;
        var name = d.querySelector('#v3-rate-name').value.trim();
        var body = msg.value.trim() + '\n\n— Įvertinimas: ' + value + '/5' + (name ? '\n— Vardas: ' + name : '') + (email.value ? '\n— El. paštas: ' + email.value.trim() : '');
        var subject = 'Atsiliepimas apie darbą (' + value + '/5) – ' + d.getAttribute('data-biz');
        d.querySelector('[data-rate-after]').hidden = false;
        window.location.href = 'mailto:' + d.getAttribute('data-mail') + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      });
    })();
  </script>
)}
