      <a class="v3-btn v3-btn--accent v3-btn--lg" href="#uzklausa" data-quote>Gauti kainą<Icon name="arrow" /></a>
      <a class="v3-btn v3-btn--ghost v3-btn--lg" href={tel} data-menu-link><Icon name="phone" />{data.phone}</a>
