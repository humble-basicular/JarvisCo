  </div>
</dialog>

{/* Mobile/tablet menu: full-screen sheet opened by the header menu button. */}
<dialog class="v3-menu" id="v3-menu" data-menu aria-label="Meniu">
  <div class="v3-menu__panel">
    <div class="v3-menu__top">
      <p class="v3-menu__brand"><strong>{data.business}</strong>{!v3.hideTagline && <span>{theme.logo.line}</span>}</p>
