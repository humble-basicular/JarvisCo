---
import V3Layout from '../../V3Layout.astro';
import V3Site from '../../V3Site.astro';
import formScript from '../../form.js?raw';
import { pageDescription, pageTitle } from '../../../heating/content';
import { siteTownLinks } from '../../../heating/town-pages';
import { loadBuild } from '../load';
const { data, site } = loadBuild();
---
<V3Layout title={pageTitle(data)} description={pageDescription(data)} theme={data.v3.theme} site={site} logo={data.logo?.src} canonical={`https://${site.domain}/`}>
  <V3Site data={data} v3={data.v3} site={site} towns={siteTownLinks(data, '') ?? []} base={data.city} home="/" />
  <script is:inline set:html={formScript}></script>
</V3Layout>
