---
/* Hero: the number and the price are the two biggest things on screen. */
import { Image } from 'astro:assets';
import { brand } from '@data/content.js';
import ContactButtons from './ContactButtons.astro';
import matas from '@assets/people/matas-face.webp';

interface Props {
  hero: {
    h1: { text: string; big?: boolean }[];
    sub: string;
    price: { big: string | null; text: string };
    payback: string;
  };
}
const { hero } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <h1 id="hero-title" class="hero__title">
      {hero.h1.map((part) => (part.big ? <span class="hero__big">{part.text}</span> : part.text))}
    </h1>
    <p class="hero__sub">{hero.sub}</p>
    <p class="hero__price">
      {hero.price.big && <><strong class="hero__price-big">{hero.price.big}</strong> </>}
      <span>{hero.price.text}</span>
    </p>
    <p class="hero__payback">{hero.payback}</p>
    <div data-hero-cta>
      <ContactButtons />
    </div>
    <p class="hero__who">
      <Image
        src={matas}
        alt=""
        width={56}
        height={56}
        widths={[56, 112, 168]}
        sizes="56px"
        loading="eager"
        fetchpriority="low"
        class="hero__avatar"
      />
      <span><strong>{brand.owner}</strong><br /><span class="small">Atsakau pats</span></span>
    </p>
  </div>
</section>

<style>
  .hero { padding: 1.75rem 0 2.25rem; }
  .hero__title { font-size: 1.75rem; font-weight: 800; margin-bottom: 1rem; }
  .hero__big { display: block; font-size: 4.75rem; line-height: 0.95; color: var(--accent); letter-spacing: -0.03em; }
  .hero__sub { font-size: 1.125rem; }
  .hero__price { font-size: 1.125rem; margin: 1.25rem 0 0.375rem; font-weight: 600; }
  .hero__price-big { display: block; font-size: 3rem; line-height: 1; font-weight: 800; letter-spacing: -0.02em; }
  .hero__payback { color: var(--muted); margin-bottom: 1.5rem; }
  .hero__who { display: flex; align-items: center; gap: 0.75rem; margin: 1.5rem 0 0; line-height: 1.3; }
  .hero__avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex: none; }

  @media (min-width: 48rem) {
    .hero { padding: 3.5rem 0 3.5rem; }
    .hero__title { font-size: 2.5rem; }
    .hero__big { font-size: 7rem; }
    .hero__price-big { font-size: 4rem; }
    .hero__sub { font-size: 1.25rem; }
  }
</style>
