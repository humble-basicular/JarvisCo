---
import { brand } from '@data/content.js';
---
<header class="header">
  <div class="wrap wrap--wide header__in">
    <a class="header__brand" href="/">{brand.name}</a>
    <a class="header__phone" href={brand.telHref} data-track="cta_call">
      <span class="visually-hidden">Skambinti </span>{brand.phone}
    </a>
  </div>
</header>

<style>
  .header { border-bottom: 1px solid var(--line); background: #fff; }
  .header__in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; }
  .header__brand { font-weight: 800; color: var(--ink); text-decoration: none; font-size: 1.0625rem; display: inline-flex; align-items: center; min-height: 3rem; }
  .header__phone { font-weight: 600; white-space: nowrap; display: inline-flex; align-items: center; min-height: 3rem; }
</style>
