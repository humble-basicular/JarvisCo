---
/* v4 header (plan §4.2 item 1): wordmark · anchors · phone icon · black
   "Gauti nemokamą peržiūrą". Mobile: wordmark, phone icon and a menu sheet in a
   native modal <dialog> (focus trap, Esc and focus return come free).
   The wordmark is the editorial light SVG, inlined in one ink colour: the
   page has a single accent (orange), so the logo's lime square is ink here. */
import { brand, utility } from '@data/content.js';
import { header } from '@data/v4.js';
import logoSvg from '../../public/brand/editorial/jarvisco-wordmark-light.svg?raw';

interface Props { nav: { label: string; href: string }[]; formHref?: string }
// Pages with the form link to it in place; others go to the homepage form.
const { nav, formHref = '/#forma' } = Astro.props;
const logo = logoSvg
  .replace(/<title>[\s\S]*?<\/title>/, '')
  .replace(/fill="#[0-9A-Fa-f]{6}"/g, 'fill="currentColor"')
  .replace('role="img" aria-label="JarvisCo"', 'aria-hidden="true" focusable="false" width="132" height="30"');
const phoneIcon = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"><path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a2.5 2.5 0 0 1-2.7 2.5C9.3 19 5 14.7 4.5 6.2A2.5 2.5 0 0 1 5 3.5Z"/></svg>';
---
<header class="hdr">
  <div class="hdr__bar wrap">
    <a class="hdr__logo" href="/" aria-label={`${brand.name}, pradžia`}><Fragment set:html={logo} /></a>
    <nav class="hdr__nav" aria-label={utility.mainNav}>
      <ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <a class="hdr__icon" href={brand.telHref} data-track="cta_call" aria-label={header.call}><Fragment set:html={phoneIcon} /></a>
    <a class="hdr__email" href={brand.emailHref} aria-label={brand.email}>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3 6 9 7 9-7" /></svg>
      <span>{brand.email}</span>
    </a>
    <a class="btn btn--ink hdr__cta" href={formHref} data-track="preview_cta">{header.cta}</a>
    <button class="hdr__icon hdr__menu" type="button" aria-haspopup="dialog" aria-controls="menu-sheet" data-menu-open>
      <span class="visually-hidden">{header.menu}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 9h16M4 15h16"/></svg>
    </button>
  </div>

  <dialog class="sheet" id="menu-sheet" aria-label={header.menu} data-menu>
    <div class="sheet__top">
      <span class="stamp">{header.menu}</span>
      <button class="hdr__icon" type="button" data-menu-close autofocus>
        <span class="visually-hidden">{header.close}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <nav aria-label={utility.menuNav}>
      <ul class="sheet__list">
        {nav.map((item, i) => <li><a href={item.href} data-menu-link><span class="stamp stamp--plain">0{i + 1}</span>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="sheet__ctas">
      <a class="btn btn--accent" href={formHref} data-menu-link data-track="preview_cta">{header.cta}</a>
      <a class="link" href={brand.telHref} data-track="cta_call">{header.call}</a>
      <a class="link" href={brand.emailHref}>{brand.email}</a>
    </div>
  </dialog>
</header>

<script>
  const sheet = document.querySelector<HTMLDialogElement>('[data-menu]');
  const open = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (sheet && open && typeof sheet.showModal === 'function') {
    open.addEventListener('click', () => sheet.showModal());
    sheet.querySelector('[data-menu-close]')?.addEventListener('click', () => sheet.close());
    sheet.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => sheet.close()));
    sheet.addEventListener('click', (e) => e.target === sheet && sheet.close());
    // Swipe right (or down) to close, like a native sheet. Passive listeners; the direction locks after
    // 10 px so a vertical scroll with sideways drift never closes the menu.
    let x0 = 0, y0 = 0, dx = 0, dy = 0, axis: '' | 'x' | 'y' = '', dragging = false;
    const reset = () => { dragging = false; axis = ''; dx = dy = 0; sheet.style.transform = ''; };
    sheet.addEventListener('touchstart', (e) => { reset(); x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; dragging = true; }, { passive: true });
    sheet.addEventListener('touchmove', (e) => {
      if (!dragging) return;
      dx = e.touches[0].clientX - x0; dy = e.touches[0].clientY - y0;
      if (!axis && Math.hypot(dx, dy) > 10) axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
      if (axis === 'x' && dx > 0) sheet.style.transform = `translateX(${dx}px)`;
      else if (axis === 'y' && dy > 0 && sheet.scrollTop <= 0) sheet.style.transform = `translateY(${dy}px)`;
      else sheet.style.transform = '';
    }, { passive: true });
    sheet.addEventListener('touchend', () => {
      const far = (axis === 'x' && dx > 90) || (axis === 'y' && dy > 120 && sheet.scrollTop <= 0);
      reset();
      if (far) sheet.close();
    }, { passive: true });
    sheet.addEventListener('touchcancel', reset, { passive: true });
    sheet.addEventListener('close', reset);
  }
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .hdr__bar { display: flex; align-items: center; gap: 0.25rem; min-height: var(--hdr-h); }
  .hdr__logo { display: inline-flex; align-items: center; min-height: 3rem; margin-right: auto; color: var(--ink); }
  .hdr__logo :global(svg) { width: 132px; height: 30px; }
  .hdr__nav { display: none; }
  .hdr__nav ul { display: flex; gap: 0.25rem; }
  .hdr__nav a { display: inline-flex; align-items: center; min-height: 3rem; padding: 0 0.875rem; font-size: 1rem; text-decoration: none; }
  .hdr__nav a:hover { text-decoration: underline; }
  .hdr__icon {
    display: inline-grid; place-items: center; width: 3rem; height: 3rem; flex: none;
    border: 0; border-radius: 4px; background: none; color: var(--ink); cursor: pointer;
  }
  .hdr__icon:hover { background: var(--paper-2); }
  .hdr__icon :global(svg), .hdr__icon svg { width: 1.375rem; height: 1.375rem; }
  .hdr__email { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-width: 3rem; min-height: 3rem; color: var(--ink); }
  .hdr__email svg { width: 1.375rem; height: 1.375rem; flex: none; }
  .hdr__email span { display: none; }
  @media (min-width: 80rem) { .hdr__email span { display: inline; font-size: 0.875rem; } }
  .hdr__cta { display: none; min-height: 3rem; padding: 0 1.25rem; font-size: 1rem; }
  @media (min-width: 64rem) {
    .hdr__nav { display: block; margin-right: 1rem; }
    .hdr__cta { display: inline-flex; margin-left: 0.5rem; }
    .hdr__menu { display: none; }
  }

  .sheet {
    width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0 var(--gutter) 2rem;
    border: 0; background: var(--paper); color: var(--ink);
  }
  .sheet { overflow-y: auto; overscroll-behavior: contain; transition: transform 0.2s var(--ease); }
  .sheet[open] { animation: sheet-in 0.28s var(--ease); }
  @keyframes sheet-in { from { transform: translateX(12%); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .sheet, .sheet[open] { animation: none; transition: none; } }
  .sheet::backdrop { background: rgb(20 20 18 / 0.4); }
  .sheet__top { display: flex; align-items: center; justify-content: space-between; min-height: var(--hdr-h); border-bottom: 1px solid var(--rule); }
  .sheet__list a {
    display: flex; align-items: baseline; gap: 1rem; min-height: 4rem; padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule); font-size: clamp(1.5rem, 7vw, 2rem); font-weight: 600; letter-spacing: -0.03em; text-decoration: none;
  }
  /* Short phones (iPhone SE 1st gen, 568 px): the whole menu fits without scrolling. */
  @media (max-height: 40rem) { .sheet__list a { min-height: 3.25rem; padding-block: 0.5rem; } .sheet__ctas { margin-top: 1.25rem; } }
  .sheet__list .stamp { color: var(--mute); font-size: 0.9375rem; }
  .sheet__ctas { display: grid; gap: 0.5rem; margin-top: 2rem; }
</style>
