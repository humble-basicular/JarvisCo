---
/* Shared call-booking quiz dialog (Stone-style: 4 choice slides, then phone → email → name → company, all required)
   + feature demo dialog (every O2 route). Preview builds validate and send nothing;
   live builds POST callback_request to same-origin /t/form (src/scripts/o2.ts). `path` tags the page in the context. */
import Icon from './Icon.astro';
import { o2 } from '@data/o2.js';
import { bookingLive } from '@data/o2-env.js';
import { brand } from '@data/content.js';
interface Props { path: string }
const { path } = Astro.props;
const { talk } = o2;
const q = talk.quiz;
const bookMsgs = JSON.stringify({ errEmail: talk.errEmail, errPhone: talk.errPhone, errName: talk.errName, errCompany: talk.errCompany, previewOk: talk.previewOk, sending: talk.sending, ok: talk.ok, err: talk.err, context: `${talk.context} (${path})` });
---
<dialog class="demodlg" data-demo-dialog aria-labelledby="dd-h">
  <div class="demodlg__top"><h2 id="dd-h" data-demo-title></h2><button type="button" class="menu__x" data-demo-close aria-label={o2.demo.close}><Icon name="x" size={28} /></button></div>
  <div class="demodlg__box" data-demo-slot></div>
</dialog>
<dialog class="bookdlg quiz" data-book-dialog aria-labelledby="bd-h">
  <div class="quiz__top">
    <button type="button" class="quiz__back" data-q-back hidden><Icon name="chev" size={22} /> {q.back}</button>
    <button type="button" class="menu__x" data-book-close aria-label={talk.close}><Icon name="x" size={28} /></button>
  </div>
  <div class="quiz__bar" role="progressbar" aria-label={q.progress} aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" data-q-bar><span style="width:50%"></span></div>
  <h2 id="bd-h" class="quiz__h">{q.title}</h2>
  <form class="book" action="/t/form" method="post" data-book-form data-book-mode={bookingLive ? 'live' : 'preview'} data-messages={bookMsgs} novalidate>
    <div class="quiz__steps" data-book-fields>
      {q.questions.map(([key, label, opts], i) => (
        <fieldset class="quiz__step" data-q-step={i} hidden={i > 0}>
          <legend class="quiz__q">{label}</legend>
          <input type="hidden" name={`q_${key}`} data-q-label={label} />
          <div class="quiz__opts">{opts.map((o) => <button type="button" class="quiz__opt" data-q-pick={o} aria-pressed="false">{o}</button>)}</div>
        </fieldset>
      ))}
      {q.fields.map(([name, label, hint, attrs], i) => (
        <div class="quiz__step" data-q-step={q.questions.length + i} data-q-field={name} hidden>
          <label class="quiz__q" for={`b-${name}`}>{label}</label>
          <p class="quiz__hint" id={`b-${name}-h`}>{hint}</p>
          <input id={`b-${name}`} name={name} required aria-describedby={`b-${name}-h b-${name}-e`} {...attrs} />
          <span class="err" id={`b-${name}-e`} data-err={name}></span>
          <button class="btn btn--big quiz__go" type="submit" disabled>{i === q.fields.length - 1 ? q.submit : q.next}</button>
        </div>
      ))}
      <label class="hp" aria-hidden="true">Svetainė<input name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <p class="status" data-status role="status" aria-live="polite" tabindex="-1"></p>
    <p class="book__call" data-book-call hidden><a href={brand.telHref} data-track="cta_call">{brand.phone}</a></p>
  </form>
  <p class="talk__or">{talk.orCall}: <a href={brand.telHref} data-track="cta_call">{brand.phone}</a></p>
</dialog>
