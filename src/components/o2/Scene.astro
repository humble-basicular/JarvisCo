// ---- timeline → keyframes ----
const css: string[] = [];
let n = 0;
const p = (t: number) => `${Math.max(0, Math.min(100, (t / T) * 100)).toFixed(3)}%`;
type Fr = [number, string, string?];
/** frames: [t, declarations, timing?]; returns class name */
function kf(frames: Fr[]) {
  const name = `k-${kind}-${++n}`;
  const body = frames.map(([t, d, tf]) => `${p(t)}{${d}${tf ? `;animation-timing-function:${tf}` : ''}}`).join('');
  css.push(`@keyframes ${name}{${body}}.${name}{animation:${name} ${T}s linear infinite}`);
  return name;
}
const E = 'ease-in-out';
const OUT = 'cubic-bezier(.2,.8,.2,1)';
const POP = 'cubic-bezier(.3,1.5,.55,1)';
/** visible between a and b (fade f), optional entry transform */
const vis = (a: number, b = T - 0.3, from = '', f = 0.3) => kf([
  [0, `opacity:0${from ? `;transform:${from}` : ''}`], [a, `opacity:0${from ? `;transform:${from}` : ''}`, OUT],
  [a + f, 'opacity:1;transform:none'],
  // b ≥ T: hold to the loop end (the parent layer does the fade); otherwise fade out (≤ 0.3 s); never two frames at 100 % (Codex r1 P3)
  ...(b >= T ? [[T, 'opacity:1;transform:none']] as Fr[]
    : b + 0.3 >= T ? [[b, 'opacity:1;transform:none', E], [T, 'opacity:0;transform:none']] as Fr[]
    : [[b, 'opacity:1;transform:none', E], [b + 0.3, 'opacity:0;transform:none'], [T, 'opacity:0']] as Fr[]),
]);
/** layer that is already visible at t=0 and leaves at b */
const first = (b: number) => kf([[0, 'opacity:1'], [b, 'opacity:1', E], [b + 0.35, 'opacity:0'], [T, 'opacity:0']]);
/** typed text: reveal left→right in `steps` between a and b, stays to loop end */
const typed = (a: number, b: number, steps: number) => kf([
  [0, 'clip-path:inset(0 100% 0 0)'], [a, 'clip-path:inset(0 100% 0 0)', `steps(${steps},end)`], [b, 'clip-path:inset(0 0 0 0)'], [T, 'clip-path:inset(0 0 0 0)'],
]);
/** class-like swap at t (off → on), back at loop end */
const turnOn = (t: number, off: string, on: string, f = 0.15) => kf([[0, off], [t, off, E], [t + f, on], [T - 0.05, on], [T, off]]);
/** on only inside [a, b] */
const during = (a: number, b: number, off: string, on: string, f = 0.15) => kf([[0, off], [a, off, E], [a + f, on], [b, on, E], [b + f, off], [T, off]]);
/** short press on a button at each t (one class per element: two keyframe classes on one element cancel each other) */
const press = (...ts: number[]) => kf([[0, 'transform:none;filter:none'], ...ts.flatMap((t) => [[t, 'transform:none;filter:none', E], [t + 0.1, 'transform:scale(.96);filter:brightness(.9)', E], [t + 0.3, 'transform:none;filter:none']] as Fr[]), [T, 'transform:none;filter:none']]);
/** pointer path: [t, x, y, click?] (x,y = point that is touched); hidden before the first point and after `hide`.
 *  ox/oy = where the touched point sits inside the pointer element. */
function pointer(path: [number, number, number, boolean?][], hide: number, ox: number, oy: number) {
  const fr: Fr[] = [];
  const at = (x: number, y: number, s = 1) => `transform:translate(${x - ox}px,${y - oy}px) scale(${s})`;
  const [t0, x0, y0] = path[0];
  fr.push([0, `opacity:0;${at(x0, y0)}`], [Math.max(0, t0 - 0.25), `opacity:0;${at(x0, y0)}`], [t0, `opacity:1;${at(x0, y0)}`, E]);
  for (let i = 1; i < path.length; i++) {
    const [t, x, y, click] = path[i];
    fr.push([t, `opacity:1;${at(x, y)}`, E]);
    if (click) fr.push([t + 0.1, `opacity:1;${at(x, y, 0.82)}`, E], [t + 0.24, `opacity:1;${at(x, y)}`, E]);
  }
  const [, xl, yl] = path[path.length - 1];
  fr.push([hide, `opacity:1;${at(xl, yl)}`, E], [hide + 0.25, `opacity:0;${at(xl, yl)}`], [T, `opacity:0;${at(xl, yl)}`]);
  return kf(fr);
}
const cursor = (path: [number, number, number, boolean?][], hide: number) => pointer(path, hide, 4, 2); // mouse arrow tip
const finger = (path: [number, number, number, boolean?][], hide: number) => pointer(path, hide, 26, 26); // 52 px touch dot
/** chat/list row that grows from 0 height (grid 0fr → 1fr) at a */
const grow = (a: number, d = 0.38) => kf([[0, 'grid-template-rows:0fr;opacity:0;transform:scale(.92)'], [a, 'grid-template-rows:0fr;opacity:0;transform:scale(.92)', OUT], [a + d, 'grid-template-rows:1fr;opacity:1;transform:none'], [T, 'grid-template-rows:1fr;opacity:1;transform:none']]);
/** typing-dots row: grows at a, collapses at b */
const dotsRow = (a: number, b: number) => kf([[0, 'grid-template-rows:0fr;opacity:0'], [a, 'grid-template-rows:0fr;opacity:0', OUT], [a + 0.3, 'grid-template-rows:1fr;opacity:1'], [b - 0.02, 'grid-template-rows:1fr;opacity:1', E], [b + 0.2, 'grid-template-rows:0fr;opacity:0'], [T, 'grid-template-rows:0fr;opacity:0']]);
/** status-bar text colour per phase: [[t, colour], …] */
function barColor(ph: [number, string][]) {
  const fr: Fr[] = [[0, `color:${ph[0][1]}`]];
  for (let i = 1; i < ph.length; i++) fr.push([ph[i][0], `color:${ph[i - 1][1]}`, E], [ph[i][0] + 0.3, `color:${ph[i][1]}`]);
  fr.push([T - 0.3, `color:${ph[ph.length - 1][1]}`, E], [T, `color:${ph[0][1]}`]);
  return kf(fr);
}

