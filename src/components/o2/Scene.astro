if (kind === 'reviews') k.bar = barColor([[0, '#111'], [10.5, '#fff']]);
const styles = css.join('');
const conf = Array.from({ length: 26 }, (_, i) => ({ x: (i * 53) % 360 + 10, y: ((i * 97) % 260) - 40, r: (i * 47) % 180, c: ['#E8A743', '#F4C45C', '#ffffff', '#D9822B'][i % 4], w: 8 + (i % 3) * 3 }));
const day = 'Antradienis, lapkričio 17';
const CH: Record<string, [string, string]> = {
  call: ['#FF3B30', 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z'],
  sms: ['#34C759', 'M12 3.5c5 0 9 3.3 9 7.4s-4 7.4-9 7.4c-.9 0-1.8-.1-2.6-.3L5 20l1.1-3.6C4.2 15 3 13.1 3 10.9 3 6.8 7 3.5 12 3.5z'],
  web: ['#2575AC', 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 4v8h14V9zm2 2h6v1.6H7zm0 3h10v1.6H7z'],
  star: ['#F5A623', 'M12 3.2l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7z'],
};
---
<figure class={`dev scn scn--${kind}`} data-dev data-scene={kind} data-side={side} style={`--T:${T}s`}>
  <div class="dev__stage" role="img" aria-label={label}>
    {kind === 'web' && (
      <div class={`lapl ${k.lap}`}>
        <img class="dev__frame" src={LAPTOP.src} width="1080" height="1336" alt="" loading="lazy" decoding="async" />
        <div class="dev__mask" style={maskCss(LAPTOP.mask)} aria-hidden="true">
          <div class="lap" style={`left:${LAPTOP.glass.x}px;top:${LAPTOP.glass.y}px;width:${LAPTOP.glass.w}px;height:${LAPTOP.glass.h}px`}>
            <div class="bsite" style={`transform:scale(${LAPTOP.scale})`}>
              <img class="bsite__img" src={B.home} width="1440" height="783" alt="" loading="lazy" decoding="async" />
            </div>
            <div class={`fm__dim ${k.dim}`}></div>
            <div class={`fm ${k.card}`} style={`left:${CX}px;top:${CY}px`}>
              <div class="fm__hd"><img src={B.logo} width="500" height="284" alt="" loading="lazy" /><div><b>Gauti pasiūlymą</b><small>Atsakymą gausite SMS žinute</small></div><i aria-hidden="true">×</i></div>
              <div class="fm__steps"><span class="on">1 Užsakymas</span><span class={k.lab2}>2 Kontaktai</span><em><u class={k.prog}></u></em></div>
              <div class="fm__vp">
                <div class={`fm__tr ${k.step}`}>
                  <div class="fm__pane">
                    <p class="fm__l">Ko reikia?</p>
                    <div class="fm__chips"><span class={`fm__chip ${k.chip}`}><i class={k.chipOk}>✓</i>Šulinio žiedai</span><span class="fm__chip">Dangčiai</span><span class="fm__chip">Kita</span></div>
                    <div class="fm__row">
                      <div><p class="fm__l">Kiekis</p><div class="fm__qty"><span>−</span><b><i class={k.q1}>1</i><i class={k.q2}>2</i><i class={k.q3}>3</i><i class={k.q4}>4</i></b><span class={k.plus}>+</span></div></div>
                      <div><p class="fm__l">Pristatymas</p><div class="fm__seg"><u class={k.seg}></u><span class={k.segA}>Reikia</span><span class={k.segB}>Atsiimsiu</span></div></div>
                    </div>
                    <p class="fm__l">Pristatymo vieta</p>
                    <span class={`fm__in ${k.f0}`}><span class={`ty ${k.t0}`}>{WF.place}</span><em>Miestas ar rajonas</em></span>
                  </div>
                  <div class="fm__pane">
                    <p class="fm__l">Vardas</p>
                    <span class={`fm__in ${k.f1}`}><span class={`ty ${k.t1}`}>{WF.name}</span></span>
                    <p class="fm__l">Telefonas</p>
                    <span class={`fm__in ${k.f2}`}><span class={`ty ${k.t2}`}>{WF.phone}</span></span>
                    <p class="fm__note"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2h1a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zm2 0h6V8a3 3 0 0 0-6 0z" fill="currentColor" /></svg>Numerį naudosime tik atsakymui į šią užklausą.</p>
                  </div>
                </div>
              </div>
              <span class={`fm__btn ${k.btn}`}><i class={k.btnA}>Toliau →</i><i class={k.btnB}>Gauti pasiūlymą</i></span>
              <div class={`fm__ok ${k.ok}`}><span class={k.okIc}>✓</span><b>Ačiū, {WF.name}!</b><small>Atsakymas jau keliauja SMS žinute į Jūsų telefoną.</small></div>
            </div>
            <svg class={`cur ${k.cur}`} width="30" height="30" viewBox="0 0 24 24"><path d="M5 3l14 8-6 1.5L10 19z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round" /></svg>
          </div>
        </div>
      </div>
    )}
    <div class={`phl${kind === 'web' ? ` ${k.ph}` : ''}`}>
      <img class="dev__frame" src={F.src} width="1080" height="1336" alt="" loading="lazy" decoding="async" />
      <div class="dev__mask" style={maskCss(F.mask)} aria-hidden="true">
      <div class={`scr scr--${kind}`} style={`width:${SCREEN_W}px;height:${SCREEN_H}px;transform:${m}`}>
        {kind === 'campaign' && <div class="scr__bg scr__bg--campaign"></div>}
        {kind === 'missed' && (<>
          <div class={`ic ${k.ic}`}>
            <p class="tagp tagp--dark">Jūsų telefonas</p>
            <p class="ic__n">+370 673 •• •••</p>
            <p class="ic__s">Mobilusis</p>
            <div class="ic__btns"><span><i class="ic__no"><svg viewBox="0 0 24 24" width="34" height="34"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" fill="#fff" transform="rotate(135 12 12)" /></svg></i>Atmesti</span><span><i class={`ic__yes ${k.ring}`}><svg viewBox="0 0 24 24" width="34" height="34"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" fill="#fff" /></svg></i>Atsiliepti</span></div>
          </div>
          <div class={`mc ${k.mc}`}>
            <span class="mc__ic"><svg viewBox="0 0 24 24" width="40" height="40"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" fill="#fff" /></svg></span>
            <b>Praleistas skambutis</b>
            <small>Dirbate objekte – atsiliepti negalite</small>
          </div>
        </>)}
        {convo && (<>
          <div class={`chatl ${k.chatl}`}>
            <div class="mh"><span class="mh__back">‹</span><span class="mh__av"><img src={B.logo} width="500" height="284" alt="" loading="lazy" /></span><b>{B.name} ›</b></div>
            <p class={`tagp ${k.who}`}>Kliento telefonas</p>
            <div class="chat">
              {convo.steps.map((st, i) => (<>
                {st.dotsA !== undefined && <div class={`cw cw--in ${k[`d${i}`]}`}><div><p class="bb bb--in bb--dots" aria-hidden="true"><i></i><i></i><i></i></p></div></div>}
                <div class={`cw ${st.from === 'biz' ? 'cw--in' : 'cw--out'} ${k[`m${i}`]}`}><div><p class={`bb ${st.from === 'biz' ? 'bb--in' : 'bb--out'}`}>{st.text}</p></div></div>
              </>))}
              <span class="chat__sp"></span>
            </div>
            <div class="ib"><span class="ib__plus">+</span><span class="ib__f"><em class={k.ph1}>SMS žinutė</em>
              {convo.steps.map((st, i) => st.typeA !== undefined && <span class={`ib__line ${k[`it${i}`]}`}><span class={`ib__x ${k[`ix${i}`]}`}>{st.text}</span><i class="ib__caret"></i><span class="ib__sp"></span></span>)}
              <span class={`ib__send ${k.sendBtn}`}>↑</span></span></div>
          </div>
          <div class={`ls ${k.ls}`}>
            <p class="ls__day">{day}</p>
            <p class="ls__time">9:41</p>
            <div class={`nt ${k.nt}`}>
              <div class="nt__top"><img src={ICON} width="40" height="40" alt="" /><span>JARVIS SYSTEMS</span><em>dabar</em></div>
              <p class="nt__h">{convo.ownerTitle}</p>
              <p class="nt__txt">{convo.owner}</p>
            </div>
            <p class="tagp tagp--dark ls__tag">Jūsų telefonas</p>
            <span class="ls__btn ls__btn--l"></span><span class="ls__btn ls__btn--r"></span>
          </div>
        </>)}
        {kind === 'reviews' && (<>
          <div class={`app ${k.A}`}>
            <div class="app__hd"><img src={ICON} width="40" height="40" alt="" /><b>Darbai</b><span class="app__n">3</span></div>
            <p class="tagp">Jūsų telefonas</p>
            <div class="job">
              <div class="job__top"><b>Tomas</b><span class="job__chip"><i class={k.chipA}>Vykdoma</i><i class={`job__chip--ok ${k.chipB}`}>Atlikta</i></span></div>
              <p class="job__l">+370 673 •• •••</p>
              <p class="job__l">3 šulinio žiedai · Garliava</p>
              <p class="job__l job__l--s">Pristatyta šiandien, 11:20</p>
              <span class="job__btn">Darbas atliktas<i class={`job__done ${k.done}`}>✓ Atlikta</i></span>
            </div>
            <div class="job job--dim"><div class="job__top"><b>Rūta</b><span class="job__chip">Vykdoma</span></div><p class="job__l">2 dangčiai · Kaunas</p></div>
            <span class={`hold ${k.hold}`}></span>
            <div class={`toast ${k.toast}`}><img src={ICON} width="34" height="34" alt="" /><p><b>Išsiųsta Tomui</b>SMS su nuoroda atsiliepimui</p></div>
          </div>
          <div class={`chatl chatl--rv ${k.B}`}>
            <div class="mh"><span class="mh__back">‹</span><span class="mh__av"><img src={B.logo} width="500" height="284" alt="" loading="lazy" /></span><b>{B.name} ›</b></div>
            <p class={`tagp ${k.whoB}`}>Kliento telefonas</p>
            <div class="chat">
              <div class={`cw cw--in ${k.rd}`}><div><p class="bb bb--in bb--dots" aria-hidden="true"><i></i><i></i><i></i></p></div></div>
              <div class={`cw cw--in ${k.rm}`}><div><p class="bb bb--in">Sveiki, Tomai! Aciu, kad rinkotes Dailius ir Ko. Busime labai dekingi uz atsiliepima: <span class={`bb__link ${k.link}`}>betonogaminiai.lt/<wbr />ivertinimas</span></p></div></div>
              <span class="chat__sp"></span>
            </div>
          </div>
          <div class={`rvp ${k.C}`}>
            <div class="rvp__band"><img src={B.logo} width="500" height="284" alt="" loading="lazy" /></div>
            <p class="rvp__h">Kaip mums sekėsi, Tomai?</p>
            <p class="rvp__s">Įvertinkite darbą – užtruks 30 sekundžių.</p>
            <p class="rvp__stars">{[0, 1, 2, 3, 4].map((i) => <span class={k.s5.split(' ')[i]}>★</span>)}</p>
            <p class={`rvp__go ${k.goog}`}>Ačiū! Atidarome Google…</p>
            <div class="rvp__url"><span>🔒 betonogaminiai.lt</span></div>
          </div>
          <div class={`gr ${k.D}`}>
            <div class="gr__top"><span class="gr__av"><img src={B.logo} width="500" height="284" alt="" loading="lazy" /></span><span><b>{B.name}</b><small>Skelbiama viešai · Google</small></span></div>
            <p class="gr__stars">{[0, 1, 2, 3, 4].map((i) => <span class={k.g5.split(' ')[i]}>★</span>)}</p>
            <p class="gr__ta"><span class={`ty ty--wrap ${k.txt}`}>Atvežė laiku, žiedai kokybiški. Rekomenduoju!</span></p>
            <span class={`gr__post ${k.post}`}>Paskelbti</span>
            <p class={`gr__ok ${k.posted}`}>✓ Atsiliepimas paskelbtas Google</p>
          </div>
          <span class={`fin ${k.fin}`}></span>
        </>)}
        {kind === 'campaign' && (<>
          <div class={`cp ${k.card}`}>
            <p class="cp__h">PRIDĖTI KLIENTĄ Į KAMPANIJĄ</p>
            <span class="cp__l">Kliento vardas</span><span class="cp__in"><span class={`ty ${k.t1}`}>Tomas</span></span>
            <span class="cp__l">Telefonas</span><span class="cp__in"><span class={`ty ${k.t2}`}>+370 698 76543</span></span>
            <span class="cp__l">Kampanija</span><span class="cp__in cp__sel">Pavasario pasiūlymas <b>▾</b></span>
            <span class={`cp__btn ${k.btn}`}>PALEISTI</span>
          </div>
          <div class={`cp-conf ${k.conf}`}>{conf.map((c) => <i style={`left:${c.x}px;top:${c.y}px;width:${c.w}px;background:${c.c};transform:rotate(${c.r}deg)`}></i>)}</div>
          <p class={`cp-ok ${k.ok}`}>KAMPANIJA<br />PALEISTA</p>
          <svg class={`cur ${k.cur}`} width="34" height="34" viewBox="0 0 24 24"><path d="M5 3l14 8-6 1.5L10 19z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round" /></svg>
          <div class="sms sms--top">
            <p class={`bb bb--out bb--wide ${k.b1}`}>Sveiki, Tomai! Čia Dailius ir ko. Ačiū, kad pernai rinkotės mus. Šį pavasarį – nuolaida šulinio dangčiams Jums ir Jūsų draugams.</p>
            <p class={`bb bb--dots bb--in ${k.d2}`}><i></i><i></i><i></i></p>
            <p class={`bb bb--in bb--wide ${k.b2}`}>Ačiū! Būtinai persiųsiu kaimynui.</p>
          </div>
        </>)}
        {kind === 'seo' && (<>
          <p class="gs__logo"><b>G</b><b>o</b><b>o</b><b>g</b><b>l</b><b>e</b></p>
          <div class="gs__q"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M10 3a7 7 0 0 1 5.6 11.2l4.6 4.6-1.4 1.4-4.6-4.6A7 7 0 1 1 10 3zm0 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10z" fill="#9aa0a6" /></svg><span class={`ty ${k.q}`}>{SEO_Q}</span><i class={k.caret}></i></div>
          <div class={`gs ${k.res}`}>
            <div class="gs__map"><i style="left:22%;top:38%"></i><i style="left:58%;top:24%"></i><i class="gs__pin--you" style="left:44%;top:62%"></i></div>
            <p class={`gs__tag ${k.tag}`}><span class={k.tagA}>Prieš optimizavimą</span><span class={k.tagB}>Po optimizavimo</span></p>
            <div class="gs__list">
              {([['a', 'Šilumos meistrai', '4,7', '38', '', 0], ['b', 'Katilų servisas', '4,6', '21', '', 1], ['you', 'Jūsų verslas', '5,0', '12', 'sildymaskaune.com', 2]] as const).map(([id, nm, r, c, url, pos]) => (
                <div class={`gs__c gs__c--${id} ${k[id]}`} style={`top:${pos * 168}px`}>
                  {id === 'you' && <i class={`gs__hi ${k.youHi}`}></i>}
                  <b>{nm}</b>
                  <span class="gs__r">{r} <em>★★★★★</em> ({c})</span>
                  <span class="gs__m">Šildymo sistemų įrengimas · Kaunas</span>
                  {url ? <span class="gs__u">{url}</span> : <span class="gs__o"><i>Atidaryta</i> · Uždaroma 18:00</span>}
                  <span class="gs__ic"><u>↗</u><u>✆</u></span>
                  {id === 'you' && <><span class={`gs__rank ${k.r3}`}>3</span><span class={`gs__rank gs__rank--1 ${k.r1}`}>1</span></>}
                </div>
              ))}
            </div>
          </div>
        </>)}
        {kind === 'inbox' && (<>
          <div class="app app--inbox">
            <div class="app__hd"><img src={ICON} width="40" height="40" alt="" /><b>Užklausos</b><span class="app__n"><i class={k.cnt0}>0</i>{[1, 2, 3, 4].map((c, i) => <i class={cnt[i]}>{c}</i>)}</span></div>
            <p class="ibx__chips"><span class="on">Visos</span><span>Skambučiai</span><span>SMS</span><span>Forma</span></p>
            <div class="ibx">
              {INBOX.map((it, i) => (
                <div class={`cw ibx__w ${k[`r${i}`]}`}><div>
                  <div class={`ibx__it ${k[`u${i}`]}`}>{i === 2 && <i class={`ibx__tap ${k.tap}`}></i>}
                    <span class="ibx__ic" style={`background:${CH[it.ch][0]}`}><svg viewBox="0 0 24 24" width="24" height="24"><path d={CH[it.ch][1]} fill="#fff" fill-rule="evenodd" /></svg></span>
                    <span class="ibx__b"><b>{it.who}<em>dabar</em></b><small>{it.t}</small><span>{it.txt}</span>{it.tag && <i>{it.tag}</i>}</span>
                  </div>
                </div></div>
              ))}
              <div class="ibx__it ibx__it--old">
                <span class="ibx__ic" style={`background:${CH.sms[0]}`}><svg viewBox="0 0 24 24" width="24" height="24"><path d={CH.sms[1]} fill="#fff" /></svg></span>
                <span class="ibx__b"><b>Paulius<em>vakar</em></b><small>SMS</small><span>Ačiū, gavau. Iki pirmadienio!</span></span>
              </div>
            </div>
            <p class="tagp tagp--bottom">Jūsų telefonas</p>
          </div>
          <span class={`fin ${k.fin}`}></span>
        </>)}
        <div class={`sb${k.bar ? ` ${k.bar}` : ''}`}>
          <span class="sb__t">9:41</span>
          <span class="sb__r">
            <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><rect y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" width="3" height="12" rx="1" /></svg>
            <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true"><path d="M8 2.3c2.4 0 4.6.9 6.3 2.5l1.2-1.3A10.9 10.9 0 0 0 8 .5C5.2.5 2.5 1.5.5 3.5l1.2 1.3C3.4 3.2 5.6 2.3 8 2.3zM8 5.9c1.4 0 2.7.5 3.7 1.4L12.9 6A7.2 7.2 0 0 0 8 4.1c-1.8 0-3.6.7-4.9 2l1.2 1.2c1-.9 2.3-1.4 3.7-1.4zM8 9.3c.6 0 1.1.2 1.5.6L8 11.5 6.5 9.9c.4-.4.9-.6 1.5-.6z" /></svg>
            <svg width="27" height="13" viewBox="0 0 27 13" aria-hidden="true"><rect x=".5" y=".5" width="23" height="12" rx="3.8" fill="none" stroke="currentColor" opacity=".4" /><rect x="2" y="2" width="20" height="9" rx="2.4" /><path d="M25 4.4v4.2c.8-.3 1.4-1.1 1.4-2.1S25.8 4.7 25 4.4z" opacity=".45" /></svg>
          </span>
        </div>
        <span class="hi"></span>
      </div>
      </div>
    </div>
  </div>
  <style is:inline set:html={styles}></style>
</figure>
