/* Feature demonstration scenes on the approved own hardware (kit v4 phones + generated blank laptop).
   Round 2 (17 Nov 2026, thread a1bf238c; Matas 2eeb25e4, mgmt DECISIONS "site rework round on top of S2"):
   - every phone screen is own HTML UI with a clean iOS status bar (signal · Wi-Fi · battery);
   - chats start at the TOP and flow down; once the screen is full, older rows scroll up (flex-end + trailing spacer);
   - customer replies are typed in the input bar first, then sent; business replies show typing dots first;
   - owner alerts are iOS lock-screen notifications from the Jarvis Systems app (logo = public/jarvis-systems/app/icon.svg);
   - web: the laptop shows the real betonogaminiai.lt home (captured pixels) with OUR redesigned two-step enquiry form;
   - reviews: owner long-presses "Darbas atliktas" → customer SMS → review page → 5 stars → Google review;
   - seo: generic heating example (search "šildymas kaunas", sildymaskaune.com), not the father's business;
   - inbox: animated owner inbox replacing the old "viena dėžutė" video row.
   Every animated element gets generated keyframes from a small timeline (t in seconds). The element's own CSS is
   the FINAL state, so reduced-motion users see a finished scene. Screens are trimmed by derived glass masks. */
import { glassMatrix, FRAMES, SCREEN_W, SCREEN_H, LAPTOP, BETONO } from '@data/o2-device.js';
import { buildConvo } from '@data/o2-convo.js';
interface Props { kind: 'web' | 'reviews' | 'missed' | 'campaign' | 'seo' | 'inbox'; side: 'left' | 'right'; label: string }
const { kind, side, label } = Astro.props;
const ICON = '/jarvis-systems/app/icon.svg';
const WEB_PHONE = 9.0; // web: laptop part ends, phone part starts
const convo = kind === 'web' ? buildConvo('web', WEB_PHONE + 1.2) : kind === 'missed' ? buildConvo('missed', 4.9) : null;
