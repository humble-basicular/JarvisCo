---
/* Funnel proof cards: where Stone shows three customer testimonial videos (Frank, Ryan, Manny) we have no customer
   videos or quotes, so the same card slots hold our real proof only: ArbCut Search Console (611 clicks, 3 months),
   ArbCut Web3Forms total (33 as of 17 Nov; the 12 Nov screenshot showed 31, so the card is a number tile now) and the Google profile (src/assets/proof/PROVENANCE.md, Matas 2026-11-12). */
import { Image } from 'astro:assets';
import { proofImage } from '@data/proof-images';
import { GOOGLE } from '@data/o2.js';
const gsc = proofImage('arbcut-gsc-3m-2026-11-19');
const stars = '★★★★★';
---
<section class="fproof" aria-label="Rezultatai">
  <article class="fcard fcard--big">
    <Image src={gsc} width={900} alt="Google Search Console, arbcut.lt, paskutiniai 3 mėnesiai: 611 paspaudimų" format="webp" quality={88} loading="lazy" />
    <div class="fcard__t"><p><b>611</b> organinių paspaudimų iš Google per 3 mėn.</p><p class="fcard__n">arbcut.lt · iki lapkr. 17 d.</p></div>
  </article>
  <div class="frow">
    <article class="fcard">
      <div class="fcard__img fcard__img--g fcard__img--n" aria-hidden="true"><b>26</b><span class="fcard__sub">užklausos</span></div>
      <div class="fcard__t"><p><b>26</b> užklausos per svetainės formą per 3,5 mėn.</p><p class="fcard__n">arbcut.lt · nuo rugpj. 1 d.</p></div>
    </article>
    <a class="fcard fcard--g" href={GOOGLE.url} target="_blank" rel="noopener">
      <div class="fcard__img fcard__img--g"><b>{GOOGLE.rating}</b><span class="fcard__stars" aria-hidden="true">{stars}</span></div>
      <div class="fcard__t"><p>Google įvertinimas {GOOGLE.rating} iš 5 ({GOOGLE.count})</p><p class="fcard__n">Jarvis Systems Google profilis</p></div>
    </a>
  </div>
</section>
