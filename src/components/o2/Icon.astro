---
/* Outline icons (stroke = currentColor), own geometry.
   badge: clean 16-point scalloped seal (computed, symmetric) with a white tick — source bullet marker.
   why-*: 48-unit outline pictograms for the six "Kodėl mes" cards (white, 50px). */
interface Props { name: string; size?: number }
const { name, size = 24 } = Astro.props;
const seal = Array.from({ length: 32 }, (_, i) => {
  const a = (Math.PI * 2 * i) / 32 - Math.PI / 2; const r = i % 2 ? 10.1 : 11.4;
  return `${(12 + r * Math.cos(a)).toFixed(2)},${(12 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');
const P: Record<string, string> = {
  badge: `<polygon points="${seal}" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M7.6 12.3l3 3 5.8-6" stroke="#fff" stroke-width="2.2" fill="none"/>`,
  chev: '<path d="M9 6l6 6-6 6"/>',
  down: '<path d="M6 9l6 6 6-6"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  x: '<path d="M6 6l12 12M18 6L6 18"/>',
  star: '<path d="M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9z" fill="currentColor" stroke="none"/>',
  'why-easy': '<path d="M20 25V12.5a2.5 2.5 0 0 1 5 0V23l7.2 1.3a3 3 0 0 1 2.4 3.3L33.5 36H22l-6-7.2a2.3 2.3 0 0 1 3.4-3z"/><path d="M15 9.5l-2.5-2.5M22.5 6.5V3M30 9.5L32.5 7"/><rect x="9" y="38.5" width="30" height="7" rx="2"/>',
  'why-price': '<circle cx="28" cy="13" r="8"/><path d="M28 9v8M25.6 11.2c0-1.2 1.1-2 2.4-2s2.4.8 2.4 2-1.1 1.8-2.4 1.8-2.4.7-2.4 1.9 1.1 2 2.4 2 2.4-.8 2.4-2"/><path d="M4 32h7l8 3h8a2.5 2.5 0 0 1 0 5h-9"/><path d="M27 38l10-6a2.6 2.6 0 0 1 3.2 4L29 44H16l-5-2H4"/>',
  'why-contract': '<circle cx="24" cy="24" r="19"/><path d="M17 13h10l5 5v17H17z"/><path d="M27 13v5h5M20.5 23h8M20.5 27h8M20.5 31h5"/><path d="M10.6 10.6l26.8 26.8"/>',
  'why-straight': '<path d="M8 10h32a3 3 0 0 1 3 3v17a3 3 0 0 1-3 3H22l-9 7v-7H8a3 3 0 0 1-3-3V13a3 3 0 0 1 3-3z"/><path d="M16 21.5l5 5 11-11"/>',
  'why-proof': '<path d="M24 4l16 6v12c0 10-7 17.5-16 21-9-3.5-16-11-16-21V10z"/><path d="M17 23.5l5 5 10-10"/>',
  'why-improve': '<path d="M6 42h36M10 42V32M18 42V26M26 42V30M34 42V18"/><path d="M8 24L20 14l7 5 13-12M33 7h7v7"/>',
};
---
<svg class="ico" width={size} height={size} viewBox={name.startsWith('why-') ? '0 0 48 48' : '0 0 24 24'} fill="none" stroke="currentColor" stroke-width={name.startsWith('why-') ? 1.6 : 2} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={P[name] ?? ''} />
