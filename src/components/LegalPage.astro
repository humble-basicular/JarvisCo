---
import Layout from '@layouts/Layout.astro';
interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props;
---
<Layout title={`${title} | jarvisweb.lt`} description={description} stickyBar={false}>
  <article class="section legal">
    <div class="wrap">
      <h1>{title}</h1>
      <p class="small">Atnaujinta {updated}</p>
      <slot />
    </div>
  </article>
</Layout>

<style>
  .legal h1 { font-size: 2rem; }
  .legal :global(h2) { font-size: 1.25rem; margin-top: 2rem; }
</style>
