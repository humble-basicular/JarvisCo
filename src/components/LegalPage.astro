---
import Layout from '@layouts/Layout.astro';
import { utility } from '@data/content.js';
interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props;
---
<Layout title={`${title} | jarvisweb.lt`} description={description}>
  <article class="wrap legal">
    <header class="legal__head">
      <a class="link" href="/">← {utility.home}</a>
      <h1 class="head__title">{title}</h1>
      <p class="small">{utility.updated} {updated}</p>
    </header>
    <div class="legal__body"><slot /></div>
  </article>
</Layout>
<style>
  .legal { max-width: 52rem; padding-block: clamp(2.5rem, 7vw, 5rem); }
  .legal__head { display: grid; gap: 1.25rem; justify-items: start; padding-bottom: 2rem; border-bottom: 1px solid var(--ink); }
  .legal__head .head__title { max-width: none; }
  .legal__body :global(h2) { font-size: clamp(1.375rem, 3vw, 1.75rem); letter-spacing: -0.025em; margin: 2.5rem 0 1rem; }
  .legal__body :global(ul) { padding-left: 1.25rem; margin-bottom: 1.5rem; list-style: disc; }
  .legal__body :global(li) { margin-bottom: 0.75rem; }
  .legal__body :global(a) { display: inline-block; min-height: 3rem; padding-block: 0.5rem; overflow-wrap: anywhere; }
</style>
