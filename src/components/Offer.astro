---
/* The offer (v2: free until the first inquiry): what is included, who it suits, the price card with the
   cost table (glowing conic border), and the first-year comparison. */
import { brand, cta, offer } from '@data/content.js';

const icons = [
  '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 13h5M8 16h8"/>',
  '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10.5 18.5h3"/><circle cx="12" cy="10" r="3"/><path d="m14.2 12.2 1.8 1.8"/>',
  '<path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 5v6h-6"/>',
];
---
<section class="sec t-dark offer" id="paslauga" aria-labelledby="offer-title">
  <div class="aurora offer__aurora" aria-hidden="true"><div class="aurora__grain"></div></div>
  <div class="wrap offer__in">
    <header class="sec-head offer__head">
      <p class="eyebrow">{offer.eyebrow}</p>
      <h2 class="sec-title" id="offer-title">{offer.title}</h2>
      <p class="sec-lead">{offer.lead}</p>
    </header>

    <div class="offer__grid">
      <div class="offer__left">
        <h3 class="offer__h">{offer.includesTitle}</h3>
        <ul class="incl">
          {offer.includes.map((item, i) => (
            <li class="incl__item" data-spot data-reveal>
              <span class="incl__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} /></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <div class="aud" data-reveal>
          <h3 class="offer__h">{offer.audienceTitle}</h3>
          <p>{offer.audienceText}</p>
          <ul class="aud__list">
            {offer.audience.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </div>

      <div class="price" id="kaina">
        <div class="price__card">
          <p class="price__tag">{offer.noMonthly}</p>
          <p class="price__big"><span class="num">{offer.price}</span> <span class="price__once">{offer.priceNote}</span></p>
          <h3 class="visually-hidden">{offer.costsTitle}</h3>
          <dl class="costs">
            {offer.costs.map((c) => (
              <div class="costs__row">
                <dt>{c.label}</dt>
                <dd>{c.value}</dd>
              </div>
            ))}
          </dl>
          <p class="price__own">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
            {offer.ownership}
          </p>
          <div class="btn-row btn-row--stack price__ctas">
            <a class="btn btn--lime" href={brand.smsHref} data-track="cta_sms" data-magnetic>{cta.sms}</a>
            <a class="btn btn--ghost" href={brand.telHref} data-track="cta_call" data-magnetic>{cta.call}</a>
          </div>
          <p class="price__payback">{offer.payback}</p>
        </div>
      </div>
    </div>

    <div class="year" data-reveal>
      <div class="year__head">
        <h3 class="offer__h">{offer.year.title}</h3>
        <p>{offer.year.lead}</p>
      </div>
      <ul class="year__bars">
        {offer.year.rows.map((r, i) => (
          <li class:list={['year__row', { 'year__row--us': i === 1 }]} style={`--w:${r.share}%`}>
            <span class="year__label">{r.label}<small>{r.detail}</small></span>
            <span class="year__track"><span class="year__bar"><b class="num">{r.value}</b></span></span>
          </li>
        ))}
      </ul>
      <p class="year__note">{offer.year.note}</p>
    </div>
  </div>
</section>

<style>
  .offer { overflow: clip; isolation: isolate; }
  .offer__aurora::before { opacity: 0.55; }
  .offer__in { position: relative; z-index: 1; }
  .offer__head { max-width: 46rem; }
  .offer__grid { display: grid; gap: 2.5rem; align-items: start; }
  .offer__h { font: 700 1.25rem/1.2 var(--font-d); letter-spacing: -0.015em; color: #fff; margin-bottom: 1rem; }

  .incl { list-style: none; display: grid; gap: 0.625rem; }
  .incl__item {
    --spot: rgba(200, 245, 96, 0.1);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border-radius: 18px;
    border: 1px solid var(--line-dark);
    background: rgba(255, 255, 255, 0.03);
    color: #e3eee7;
    line-height: 1.4;
  }
  .incl__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: rgba(200, 245, 96, 0.1);
    color: var(--lime);
  }
  .incl__icon svg { width: 1.375rem; height: 1.375rem; }

  .aud { margin-top: 2.25rem; }
  .aud p { color: var(--mute-dark); }
  .aud__list { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .aud__list li {
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 0.9375rem;
    color: #dbe8e0;
  }

  /* ---------- Price card with rotating conic border ---------- */
  .price {
    --angle: 0deg;
    position: relative;
    border-radius: 30px;
    padding: 1.5px;
    background: conic-gradient(from var(--angle), var(--lime), var(--em), var(--ice), rgba(12, 29, 21, 0.2) 38%, rgba(12, 29, 21, 0.2) 62%, var(--lime));
    box-shadow: 0 40px 100px -40px rgba(31, 191, 117, 0.55);
    scroll-margin-top: calc(var(--hdr-h) + 1rem);
  }
  .price::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    /* Static glow: animating a blurred layer repaints it every frame. */
    background: conic-gradient(from 200deg, var(--lime), var(--em), var(--ice), rgba(12, 29, 21, 0.2) 38%, rgba(12, 29, 21, 0.2) 62%, var(--lime));
    filter: blur(18px);
    opacity: 0.45;
  }
  @property --angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  @media (prefers-reduced-motion: no-preference) {
    .price { animation: spin 7s linear infinite; }
  }
  @keyframes spin { to { --angle: 360deg; } }
  .price__card {
    position: relative;
    border-radius: 28.5px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background:
      radial-gradient(90% 60% at 100% 0%, rgba(31, 191, 117, 0.16), transparent 60%),
      #0a1711;
  }
  .price__tag {
    display: inline-flex;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: rgba(200, 245, 96, 0.12);
    color: var(--lime);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .price__big { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin-bottom: 1.5rem; }
  .price__big .num { font-size: clamp(4.5rem, 18vw, 6.5rem); font-weight: 800; line-height: 0.9; color: #fff; }
  .price__once { font: 600 1.25rem/1.2 var(--font-d); color: var(--mute-dark); }
  .costs { margin: 0 0 1.25rem; }
  .costs__row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line-dark);
    font-size: 1rem;
  }
  .costs__row dt { color: var(--mute-dark); }
  .costs__row dd { margin: 0; color: #fff; font-weight: 600; text-align: right; }
  .price__own { display: flex; gap: 0.75rem; padding: 1rem; border-radius: 16px; background: rgba(255, 255, 255, 0.04); color: #dbe8e0; font-size: 0.9375rem; }
  .price__own svg { width: 1.375rem; height: 1.375rem; flex: none; color: var(--lime); }
  .price__ctas { margin-top: 1.5rem; }
  .price__ctas .btn { flex: 1; }
  .price__payback { margin: 1.25rem 0 0; font-size: 0.9375rem; color: var(--mute-dark); }

  /* ---------- First-year comparison ---------- */
  .year {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--r-l);
    border: 1px solid var(--line-dark);
    background: rgba(255, 255, 255, 0.025);
  }
  .year__head p { color: var(--mute-dark); }
  .year__bars { list-style: none; display: grid; gap: 1.125rem; margin: 1.25rem 0; }
  .year__row { display: grid; gap: 0.5rem; }
  .year__label { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; font-weight: 600; color: #fff; }
  .year__label small { font-weight: 400; font-size: 0.875rem; color: var(--mute-dark); }
  .year__track { display: block; }
  .year__bar {
    display: flex;
    align-items: center;
    width: var(--w);
    min-width: 7rem;
    height: 3.25rem;
    padding: 0 1rem;
    border-radius: 14px;
    background: #24362d;
    transform-origin: left;
  }
  .year__bar b { font-size: 1.375rem; font-weight: 800; color: #fff; }
  .year__row--us .year__bar { background: linear-gradient(90deg, var(--lime), var(--em)); box-shadow: 0 10px 40px -10px rgba(200, 245, 96, 0.5); }
  .year__row--us .year__bar b { color: var(--ink); }
  .year__note { margin: 0; color: #c3d6cb; max-width: 50rem; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .year__bar { animation: bar-x linear both; animation-timeline: view(); animation-range: entry 30% cover 40%; }
    }
  }
  @keyframes bar-x { from { transform: scaleX(0.15); } }

  @media (min-width: 64rem) {
    .offer__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; }
    .year { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 1rem 4rem; align-items: center; }
    .year__bars { margin: 0; }
    .year__note { grid-column: 1 / -1; padding-top: 1.25rem; border-top: 1px solid var(--line-dark); }
    .year__row { grid-template-columns: 11rem 1fr; align-items: center; }
    .year__label { display: grid; gap: 0.125rem; }
  }
</style>
