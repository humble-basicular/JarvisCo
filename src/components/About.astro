---
import { Image } from 'astro:assets';
import { about, brand } from '@data/content.js';
import matas from '@assets/people/matas.webp';
---
<section class="section" id="apie" aria-labelledby="about-title">
  <div class="wrap about">
    <Image
      src={matas}
      alt="Matas Bašinskas prie savo darbo vietos"
      widths={[240, 480, 720]}
      sizes="(min-width: 48rem) 15rem, 40vw"
      quality={78}
      loading="lazy"
      class="about__img"
    />
    <div>
      <h2 id="about-title">{about.title}</h2>
      <p>{about.text}</p>
      <ul class="about__links">
        <li><a href={brand.telHref} data-track="cta_call">{brand.phone}</a></li>
        <li><a href={brand.emailHref}>{brand.email}</a></li>
        <li><a href={brand.gbp} rel="noopener">{about.gbpLabel}</a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1.25rem; align-items: start; }
  .about__img { width: 100%; aspect-ratio: 10 / 13; object-fit: cover; border-radius: var(--radius); }
  .about > div { min-width: 0; }
  .about__links { list-style: none; padding: 0; margin: 0; }
  .about__links a { display: inline-flex; align-items: center; min-height: 3rem; font-weight: 600; overflow-wrap: anywhere; }
  @media (max-width: 22rem) { .about { grid-template-columns: 1fr; } .about__img { width: 9rem; } }
  @media (min-width: 48rem) { .about { grid-template-columns: 15rem 1fr; gap: 2rem; } }
</style>
