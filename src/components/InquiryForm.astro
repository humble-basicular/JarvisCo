---
import { contact, brand } from '@data/content.js';
import Icon from './Icon.astro';

const { showMessage = true, submitLabel = contact.submit, source = 'svetainė' } = Astro.props;
---
<form class="inq" data-inquiry-form>
  <input type="hidden" name="access_key" value={contact.web3formsKey} />
  <input type="hidden" name="subject" value={`Nauja užklausa iš jarvisweb.lt (${source})`} />
  <input type="hidden" name="from_name" value="JarvisCo svetainė" />
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <label class="field">
    <span class="field__label">{contact.fields.name}</span>
    <input type="text" name="name" required autocomplete="name" placeholder="Jūsų vardas" />
  </label>
  <label class="field">
    <span class="field__label">{contact.fields.phone}</span>
    <input
      type="tel"
      name="phone"
      required
      inputmode="tel"
      autocomplete="tel"
      title="Įveskite teisingą telefono numerį, pvz. +370 612 34 567"
      placeholder="+370 6xx xx xxx"
    />
  </label>
  <label class="field">
    <span class="field__label">{contact.fields.email}</span>
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      title="Įveskite teisingą el. pašto adresą, pvz. vardas@pastas.lt"
      placeholder="vardas@pastas.lt"
    />
  </label>
  {showMessage && (
    <label class="field">
      <span class="field__label">{contact.fields.message}</span>
      <textarea name="message" rows="4" placeholder="Pvz.: reikia svetainės santechnikos verslui"></textarea>
    </label>
  )}

  <button type="submit" class="btn btn--primary btn--block btn--lg" data-submit>
    {submitLabel}<Icon name="arrow" />
  </button>
  <p class="inq__privacy">{contact.privacy}</p>
  <div class="inq__result" data-result hidden></div>
</form>

<style>
  .field { display: block; margin-bottom: 1rem; }
  .field__label { display: block; font-size: 0.86rem; color: var(--text-soft); margin-bottom: 0.4rem; font-weight: 500; }
  .field input, .field textarea {
    width: 100%;
    background: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    padding: 0.8rem 1rem;
    color: var(--text);
    font-size: 1rem;
    transition: border-color 0.25s, box-shadow 0.25s;
    resize: vertical;
  }
  .field input::placeholder, .field textarea::placeholder { color: #5e6663; }
  .field input:focus, .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--glow);
  }
  .hp { position: absolute; left: -9999px; opacity: 0; }
  .inq__privacy { color: var(--muted); font-size: 0.8rem; margin-top: 0.9rem; text-align: center; }
  .inq__result {
    margin-top: 1.1rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--r-sm);
    font-size: 0.92rem;
    text-align: center;
  }
  .inq__result.is-ok { background: rgba(198,242,78,0.12); border: 1px solid rgba(198,242,78,0.4); color: var(--accent); }
  .inq__result.is-err { background: rgba(255,95,87,0.1); border: 1px solid rgba(255,95,87,0.4); color: #ff8a82; }
</style>

<script>
  import { validateEmail } from '@scripts/email_validation.js';

  // Laukia, kol DOM'e atsiras elementas (chat widget'as mounto'jasi asinchroniškai).
  function waitForEl(selector, timeout = 5000) {
    return new Promise((resolve) => {
      const existing = document.querySelector(selector);
      if (existing) return resolve(existing);
      const start = Date.now();
      const iv = setInterval(() => {
        const el = document.querySelector(selector);
        if (el) {
          clearInterval(iv);
          resolve(el);
        } else if (Date.now() - start > timeout) {
          clearInterval(iv);
          resolve(null);
        }
      }, 80);
    });
  }

  // Tikriname, kad būtų įvestas veikiantis (teisingo formato) telefonas.
  function isValidLtPhone(v) {
    const n = v.replace(/[\s\-()]/g, '');
    return /^(\+370|370|8)\d{8}$/.test(n);
  }

  // Iš formos laukų sudaro pirmą žinutę pokalbiui (vartotojo vardu).
  function buildChatMessage(data) {
    const name = String(data.get('name') || '').trim();
    const phone = String(data.get('phone') || '').trim();
    const email = String(data.get('email') || '').trim();
    const message = String(data.get('message') || '').trim();
    const parts = [name ? `Labas! Mano vardas – ${name}.` : 'Labas!'];
    const contacts = [];
    if (phone) contacts.push(`tel. ${phone}`);
    if (email) contacts.push(`el. paštas ${email}`);
    if (contacts.length) parts.push(`Susisiekti su manimi galima: ${contacts.join(', ')}.`);
    if (message) parts.push(`Apie projektą: ${message}`);
    parts.push('Norėčiau gauti pasiūlymą ir, jei tinka, suderinti nemokamą konsultaciją.');
    return parts.join(' ');
  }

  // Atidaro pokalbio langą ir nusiunčia agentui pirmą žinutę.
  async function handoffToChat(text) {
    const toggle = await waitForEl('.chat-window-toggle');
    if (!(toggle instanceof HTMLElement)) return false;
    // Atidarom langą, jei jis dar uždarytas (kai atidarytas — yra įvesties laukelis).
    if (!document.querySelector('.chat-inputs textarea')) {
      toggle.click();
    }
    const textarea = await waitForEl('.chat-inputs textarea');
    if (!(textarea instanceof HTMLTextAreaElement)) return false;
    // Reikšmę nustatom per native setter'į, kad Vue v-model ją pamatytų.
    const setValue = Object.getOwnPropertyDescriptor(
      HTMLTextAreaElement.prototype,
      'value',
    )?.set;
    if (setValue) setValue.call(textarea, text);
    else textarea.value = text;
    textarea.dispatchEvent(new Event('input', { bubbles: true }));
    textarea.focus();
    await new Promise((r) => setTimeout(r, 80));
    const sendBtn = document.querySelector('.chat-input-send-button');
    if (sendBtn instanceof HTMLElement) {
      sendBtn.click();
    } else {
      textarea.dispatchEvent(
        new KeyboardEvent('keydown', { key: 'Enter', bubbles: true }),
      );
    }
    return true;
  }

  const forms = document.querySelectorAll('[data-inquiry-form]');
  forms.forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    const result = form.querySelector('[data-result]');
    const btn = form.querySelector('[data-submit]');
    const showMsg = (ok, text) => {
      if (!(result instanceof HTMLElement)) return;
      result.hidden = false;
      result.className = 'inq__result ' + (ok ? 'is-ok' : 'is-err');
      result.textContent = text;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('botcheck')) return; // honeypot
      const key = String(data.get('access_key') || '');
      if (key.startsWith('PAKEISK')) {
        showMsg(false, 'Forma dar nesukonfigūruota. Skambinkite +370 676 99395 arba rašykite jarviswork.co@gmail.com');
        return;
      }

      // Privaloma įvesti veikiantį telefoną IR el. paštą (be giberish).
      const phoneInput = form.querySelector('[name="phone"]');
      const emailInput = form.querySelector('[name="email"]');
      if (!isValidLtPhone(String(data.get('phone') || ''))) {
        showMsg(false, 'Įveskite teisingą telefono numerį, pvz. +370 612 34 567.');
        if (phoneInput instanceof HTMLElement) phoneInput.focus();
        return;
      }
      if (!isValidEmail(String(data.get('email') || ''))) {
        showMsg(false, 'Įveskite teisingą el. pašto adresą, pvz. vardas@pastas.lt.');
        if (emailInput instanceof HTMLElement) emailInput.focus();
        return;
      }

      if (btn instanceof HTMLButtonElement) { btn.disabled = true; btn.style.opacity = '0.7'; }

      // 1) Pagrindinis kelias: perduodam pokalbiui ir nusiunčiam duomenis agentui.
      const opened = await handoffToChat(buildChatMessage(data));
      showMsg(
        true,
        opened
          ? 'Ačiū! Tęskime pokalbyje – langas atsidarė apačioje dešinėje 👇'
          : 'Ačiū! Gavau Jūsų užklausą ir netrukus susisieksiu.',
      );

      // 2) Atsarginė kopija el. paštu (fone — neprarandam užklausos, jei pokalbis nebaigiamas).
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json();
        if (json.success) form.reset();
      } catch {
        // El. laiškas nepavyko — ne kritiška, pokalbis jau atidarytas.
      } finally {
        if (btn instanceof HTMLButtonElement) { btn.disabled = false; btn.style.opacity = ''; }
      }
    });
  });
</script>
