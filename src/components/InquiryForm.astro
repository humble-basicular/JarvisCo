---
/* Web3Forms inquiry form. Posts natively without JS; inquiry-form.ts adds
   accessible validation (phone AND e-mail required, as before the rebuild). */
import { form, footer } from '@data/content.js';

interface Props { source: string }
const { source } = Astro.props;
const messages = JSON.stringify({ ...form.errors, success: form.success, failure: form.failure, sending: form.sending });
---
<form class="form" action={form.endpoint} method="POST" data-inquiry-form data-messages={messages} aria-labelledby="form-title">
  <h3 id="form-title">{form.title}</h3>
  <p class="small">{form.lead}</p>

  <input type="hidden" name="access_key" value={form.web3formsKey} />
  <input type="hidden" name="subject" value={`Nauja užklausa iš jarvisweb.lt (${source})`} />
  <input type="hidden" name="from_name" value="jarvisweb.lt" />
  <input type="checkbox" name="botcheck" class="form__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="field">
    <label for={`f-name-${source}`}>{form.fields.name}</label>
    <input id={`f-name-${source}`} type="text" name="name" required autocomplete="name" aria-describedby={`e-name-${source}`} />
    <p class="field__err" id={`e-name-${source}`} data-error="name" hidden></p>
  </div>
  <div class="field">
    <label for={`f-phone-${source}`}>{form.fields.phone}</label>
    <input
      id={`f-phone-${source}`}
      type="tel"
      name="phone"
      required
      inputmode="tel"
      autocomplete="tel"
      pattern={String.raw`[+0-9 \(\)\-]{9,20}`}
      placeholder="+370 6xx xxxxx"
      aria-describedby={`e-phone-${source}`}
    />
    <p class="field__err" id={`e-phone-${source}`} data-error="phone" hidden></p>
  </div>
  <div class="field">
    <label for={`f-email-${source}`}>{form.fields.email}</label>
    <input
      id={`f-email-${source}`}
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="vardas@pastas.lt"
      aria-describedby={`e-email-${source}`}
    />
    <p class="field__err" id={`e-email-${source}`} data-error="email" hidden></p>
  </div>
  <div class="field">
    <label for={`f-msg-${source}`}>{form.fields.message}</label>
    <textarea id={`f-msg-${source}`} name="message" rows="3"></textarea>
  </div>

  <button type="submit" class="btn btn--ink form__submit">{form.submit}</button>
  <p class="small form__privacy">{form.privacy} <a href="/privatumo-politika">{footer.privacy.label}</a>.</p>
  <p class="form__status" data-status role="status" aria-live="polite"></p>
</form>

<script>
  import '../scripts/inquiry-form';
</script>

<style>
  .form { background: #fff; color-scheme: light; border: 1px solid var(--line-light); border-radius: var(--r-l); padding: clamp(1.25rem, 3vw, 2.5rem); box-shadow: 0 30px 70px -50px rgba(6,17,12,.3); }
  .form h3 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.75rem; }
  .form > .small { color: var(--mute-light); }
  .field { margin-bottom: 1rem; }
  .field label { display: block; font-weight: 600; margin-bottom: 0.375rem; }
  .field input, .field textarea {
    width: 100%; min-height: 3.25rem; padding: 0.75rem 0.875rem;
    font: inherit; color: var(--ink); background: #fff;
    border: 2px solid #8a8f96; border-radius: 10px;
  }
  .field textarea { resize: vertical; }
  .field input:focus-visible, .field textarea:focus-visible { outline: 3px solid var(--em-ink); outline-offset: 1px; border-color: var(--em-ink); }
  .field input[aria-invalid='true'] { border-color: var(--err); }
  .field__err { color: var(--err); font-weight: 600; font-size: 0.9375rem; margin: 0.375rem 0 0; }
  .form__hp { position: absolute; left: -9999px; opacity: 0; }
  .form__submit { width: 100%; }
  .form__submit:disabled { opacity: 0.65; cursor: wait; }
  .form__privacy a { display: inline-flex; align-items: center; min-height: 3rem; }
  .form__privacy { margin: 0.75rem 0 0; }
  .form__status { margin: 0.75rem 0 0; font-weight: 600; }
  .form__status:empty { display: none; }
  .form__status.is-ok { color: var(--em-ink); }
  .form__status.is-err { color: var(--err); }
</style>
