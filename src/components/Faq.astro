---
/* Native details preserve keyboard operation and content without JavaScript. */
import { faq, cta, brand } from '@data/content.js';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<section class="sec t-paper faq-section" id="duk" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <header class="sec-head">
      <p class="eyebrow">{faq.eyebrow}</p>
      <h2 class="sec-title" id="faq-title">{faq.title}</h2>
      <p class="sec-lead">{faq.aside}</p>
      <a class="text-link" href={brand.smsHref} data-track="cta_sms">{cta.sms}<span aria-hidden="true">↗</span></a>
    </header>
    <div class="faq">
      {items.map((item, i) => (
        <details class="faq__item" name="faq">
          <summary><span class="faq__n num" aria-hidden="true">0{i + 1}</span><span>{item.q}</span></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq-section { background: var(--paper-2); }
  .faq-grid { display: grid; gap: 0.5rem; }
  .faq-grid .text-link { margin-top: 1rem; color: var(--em-ink); }
  .faq { display: grid; gap: 0.75rem; }
  .faq__item { background: var(--card); border: 1px solid var(--line-light); border-radius: var(--r); }
  .faq__item summary { cursor: pointer; list-style: none; position: relative; min-height: 4.5rem; padding: 1.125rem 3rem 1.125rem 1.125rem; font-weight: 600; display: flex; gap: 0.875rem; align-items: baseline; line-height: 1.45; }
  .faq__n { color: var(--em-ink); font-size: 0.875rem; flex: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; position: absolute; right: 1.125rem; top: 50%; transform: translateY(-50%); font-size: 1.5rem; font-weight: 400; color: var(--em-ink); }
  .faq__item[open] summary::after { content: '−'; }
  .faq__item[open] { border-color: #7c9e86; }
  .faq__item p { margin: 0; padding: 0 1.125rem 1.5rem; color: var(--mute-light); }
  @media (min-width: 64rem) { .faq-grid { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 5rem; } .faq__item p { padding-left: 3.5rem; } }
</style>
