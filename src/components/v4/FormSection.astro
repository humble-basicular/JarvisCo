---
/* Final CTA + the step-by-step form (plan §4.2 item 12). */
import { cta } from '@data/v4.js';
import PreviewForm from '@components/funnel/PreviewForm.astro';

interface Props { trade?: string }
const { trade } = Astro.props;
---
<section class="sec fs" id="forma" aria-labelledby="forma-title">
  <div class="wrap fs__grid">
    <div class="fs__head">
      <p class="label">{cta.label}</p>
      <h2 class="head__title" id="forma-title" tabindex="-1"><span class="reveal-line" data-reveal>{cta.title}</span></h2>
      <p class="head__text">{cta.text}</p>
    </div>
    <div class="fs__form"><PreviewForm trade={trade} /></div>
  </div>
</section>

<style>
  .fs { border-top: 1px solid var(--ink); }
  .fs__grid { display: grid; gap: 2.5rem; }
  .fs__head { display: grid; gap: 1.25rem; align-content: start; }
  .fs__head h2:focus { outline: none; }
  @media (min-width: 64rem) {
    .fs__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 4rem; }
    .fs__head { position: sticky; top: calc(var(--hdr-h) + 2rem); }
  }
</style>
