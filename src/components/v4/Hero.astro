---
/* Real client work on home; the actual heating demo on the trade page. */
import { Image } from 'astro:assets';
import { brand } from '@data/content.js';
import { hero, MAIN_CTA } from '@data/v4.js';
import crown from '@assets/arbcut/mantas-lajoje.jpg';
import heating from '@assets/proof/sildymas-mobile-2026-10-15.png';

interface Props { variant?: 'home' | 'heating' }
const { variant = 'home' } = Astro.props;
const v = hero[variant];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    {'stamp' in v && <p class="stamp hero__stamp">{v.stamp}</p>}
    <h1 class="hero__title" id="hero-title">
      {v.lines.map((line, i) => <span class="reveal-line" style={`--i:${i}`}>{line} </span>)}
    </h1>
    <div class="hero__row">
      <div class="hero__sub">{hero.sub.map((p) => <p>{p}</p>)}</div>
      <div class="hero__ctas">
        <a class="btn btn--accent btn--big" href="#forma" data-track="preview_cta">{MAIN_CTA}</a>
        <a class="link" href={brand.smsHref} data-track="cta_sms">{hero.sms}</a>
      </div>
    </div>
  </div>
  <div class={`hero__object ${variant === 'heating' ? 'hero__object--screen' : ''}`}>
    <Image src={variant === 'home' ? crown : heating} alt={v.photoAlt}
      widths={variant === 'home' ? [390, 640, 900] : [320, 390]}
      sizes={variant === 'home' ? '(min-width: 48rem) 82vw, calc(100vw - 1.25rem)' : '(min-width: 28rem) 390px, calc(100vw - 2.5rem)'}
      format="webp" quality={82} loading="eager" />
  </div>
</section>

<style>
  .hero { padding-top: clamp(2.5rem, 7vw, 5.5rem); overflow: clip; }
  .hero__stamp { margin-bottom: 1.25rem; }
  .hero__title { font-size: clamp(2.75rem, 8.6vw, 7.5rem); font-weight: 600; line-height: 0.95; letter-spacing: -0.05em; max-width: 15ch; }
  .hero__row { display: grid; gap: 2rem; margin-top: clamp(1.75rem, 4vw, 3rem); }
  .hero__sub { max-width: 34rem; color: var(--ink-2); font-size: clamp(1.0625rem, 0.6vw + 0.95rem, 1.25rem); }
  .hero__sub p { margin-bottom: 0.5rem; }
  .hero__ctas { display: grid; gap: 0.5rem; justify-items: start; align-content: start; }
  .hero__ctas .btn { width: 100%; }
  .hero__object { margin-top: clamp(2.5rem, 6vw, 4rem); margin-left: var(--gutter); border: 1px solid var(--rule); }
  .hero__object :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 43%; }
  .hero__object--screen { width: min(390px, calc(100% - 2 * var(--gutter))); margin-inline: auto; }
  .hero__object--screen :global(img) { aspect-ratio: 390 / 844; object-fit: contain; }
  @media (min-width: 48rem) {
    .hero__ctas .btn { width: auto; }
    .hero__object:not(.hero__object--screen) { margin-left: 18%; }
    .hero__object:not(.hero__object--screen) :global(img) { aspect-ratio: 21 / 8; }
  }
  @media (min-width: 64rem) {
    .hero__row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 4rem; align-items: start; }
  }
</style>
