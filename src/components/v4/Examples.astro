---
/* Actual 390 × 844 headless Chrome screenshots; straight frames, no mockups. */
import { Image } from 'astro:assets';
import heating from '@assets/proof/sildymas-mobile-2026-10-15.png';
import arbcut from '@assets/proof/arbcut-mobile-2026-10-15.png';
import { examples } from '@data/v4.js';
import Head from './Head.astro';
const screenshots = [heating, arbcut];
---
<section class="sec" id="pavyzdys" aria-labelledby="pavyzdys-title">
  <div class="wrap">
    <Head id="pavyzdys-title" label={examples.label} title={examples.title} text={examples.text} />
    <ul class="ex">
      {examples.items.map((it, i) => (
        <li>
          <figure>
            <Image src={screenshots[i]} alt={it.photoAlt} widths={[320, 390]} sizes="(min-width: 28rem) 390px, calc(100vw - 2.5rem)" format="webp" quality={85} loading="lazy" />
            <figcaption>
              <p class="stamp ex__note">{it.note}</p>
              <h3>{it.title}</h3>
            </figcaption>
          </figure>
          <a class="link" href={it.href} {...(it.href.startsWith('http') ? { rel: 'noopener', 'data-track': 'arbcut' } : {})}>{it.link} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ex { display: grid; gap: 3.5rem; }
  .ex figure { margin: 0; }
  .ex :global(img) { width: 100%; max-width: 390px; height: auto; border: 1px solid var(--rule); }
  .ex__note { margin: 1.25rem 0 0.5rem; }
  .ex h3 { font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -0.03em; line-height: 1.1; }
  @media (min-width: 48rem) {
    .ex { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(1.5rem, 4vw, 4rem); }
    .ex li:nth-child(2) { margin-top: 6rem; }
  }
</style>
