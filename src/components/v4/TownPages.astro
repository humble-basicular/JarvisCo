---
/* "Miestų puslapiai" (W4a): why each town gets its own page, with arbcut.lt's real city-page figures
   (Search Console Pages tab, dated screenshot) and the three demo town pages.
   Every figure is visible in its screenshot (src/assets/proof/PROVENANCE.md). */
import { Image, getImage } from 'astro:assets';
import { townPages, proof as v4proof } from '@data/v4.js';
import { proofImage } from '@data/proof-images';
import { townLinks } from '../../templates/heating/towns';
import Head from './Head.astro';

const towns = townLinks();
const p = townPages.proof;
const shot = proofImage(p.file.replace(/\.\w+$/, ''));
const big = (src: ImageMetadata) => getImage({ src, width: 2400, format: 'webp', quality: 85 });
const full = await big(shot);
const sizes = '(min-width: 82rem) 75rem, calc(100vw - 2.5rem)';
---
<section class="sec" id="miestu-puslapiai" aria-labelledby="miestu-puslapiai-title">
  <div class="wrap">
    <Head id="miestu-puslapiai-title" label={townPages.label} title={townPages.title} text={townPages.text} />
    <figure class="tp">
      <p class="tp__stat"><strong>{p.stat.value} <small>{p.stat.of}</small></strong><span>{p.stat.label}</span></p>
      <table class="tp__table">
        <thead><tr>{p.head.map((h: string) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{p.rows.map((r: { town: string; path: string; clicks: string; impressions: string }) => <tr><th scope="row">{r.town}</th><td>{r.clicks}</td><td>{r.impressions}</td></tr>)}</tbody>
      </table>
      <p class="tp__sum">{p.sum}</p>
      <a class="tp__img" href={full.src}><Image src={shot} alt={p.alt} widths={[640, 960, 1400, 2000]} sizes={sizes} format="webp" quality={80} loading="lazy" /></a>
      <figcaption><span class="tp__zoom">{v4proof.zoom}</span><span>{p.caption}</span><span class="stamp stamp--plain tp__meta">{p.meta}</span></figcaption>
    </figure>

    <h3 class="tp__demo-title">{townPages.demoTitle}</h3>
    <ul class="gt">
      {towns.map((t) => (
        <li class="gt__row">
          <h3 class="stamp gt__q">{t.name}</h3>
          <p class="gt__a">Pavyzdys: vietovės puslapyje – {t.places.slice(0, 4).join(', ')}.</p>
          <a class="link" href={t.href} target="_blank" rel="noopener">{townPages.open}<span class="visually-hidden">: šildymas {t.loc} (atsidaro naujame skirtuke)</span></a>
        </li>
      ))}
    </ul>
    <p class="gt__note">{townPages.note}</p>
  </div>
</section>

<style>
  .tp { margin: clamp(2rem, 5vw, 3rem) 0 clamp(3.5rem, 8vw, 5rem); }
  .tp__stat { display: grid; gap: 0.375rem; max-width: 46rem; margin: 0 0 1.5rem; padding-top: 1rem; border-top: 1px solid var(--ink); }
  .tp__stat strong { font-size: clamp(3rem, 10vw, 5.5rem); font-weight: 600; letter-spacing: -0.05em; line-height: 1; }
  .tp__stat small { font-size: 0.4em; letter-spacing: -0.02em; color: var(--ink-2); }
  .tp__stat span { font-size: 1.0625rem; font-weight: 600; }
  .tp__table { width: 100%; max-width: 36rem; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .tp__table th, .tp__table td { padding: 0.5rem 0; border-bottom: 1px solid var(--rule); text-align: right; font-size: 0.9375rem; }
  .tp__table th:first-child { text-align: left; }
  .tp__table thead th { color: var(--mute); font-weight: 500; font-size: 0.8125rem; }
  .tp__table tbody th { font-weight: 600; }
  .tp__sum { max-width: 46rem; margin: 1rem 0 1.5rem; color: var(--ink-2); font-size: 0.9375rem; }
  .tp__img { display: block; border: 1px solid var(--rule); background: #fff; }
  .tp__img :global(img) { width: 100%; height: auto; }
  .tp figcaption { display: grid; gap: 0.5rem; margin-top: 1rem; max-width: 46rem; }
  .tp__zoom { color: var(--ink); font-size: 0.875rem; font-weight: 600; }
  @media (hover: hover) and (pointer: fine) { .tp__zoom { display: none; } }
  .tp__meta { color: var(--mute); font-size: 0.875rem; }
  .tp__demo-title { margin-bottom: 0.75rem; font-size: clamp(1.375rem, 3vw, 1.75rem); letter-spacing: -0.02em; }
  .gt { border-top: 1px solid var(--ink); }
  .gt__row { display: grid; gap: 0.5rem; padding-block: 1.5rem; border-bottom: 1px solid var(--rule); }
  .gt__row:last-child { border-bottom: 0; }
  .gt__q { grid-column: 1 / -1; margin: 0; font-size: 0.9375rem; }
  .gt__a { margin: 0; font-weight: 600; }
  .gt__note { max-width: 40rem; margin-top: clamp(2rem, 5vw, 3rem); padding-top: 1.5rem; border-top: 1px solid var(--rule); color: var(--ink-2); }
  @media (min-width: 64rem) {
    .gt__row { grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; column-gap: clamp(1rem, 4vw, 4rem); }
  }
</style>
