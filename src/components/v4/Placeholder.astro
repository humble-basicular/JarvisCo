---
/* Marked photo/screenshot slot (plan §4.4): a neutral frame with a stamp that
   names the shot Jarvis still has to supply. Never stock or AI people. */
interface Props { text: string; ratio?: string; class?: string }
const { text, ratio = '4 / 3', class: cls = '' } = Astro.props;
const [kind, ...rest] = text.split(':');
---
<div class={`ph ${cls}`} style={`--ratio:${ratio}`} role="img" aria-label={text}>
  <span class="ph__text" aria-hidden="true">
    <span class="stamp">{kind}</span>
    <span class="ph__note">{rest.join(':').trim()}</span>
  </span>
</div>
