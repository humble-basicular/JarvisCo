---
/* Before/after strip (hero plan §5, D3). Left: a generic portal-style profile
   card drawn in HTML from the demo's own made-up data: no real portal name or
   logo, no rating, no person. Right: the same business as the demo site (the
   real capture used in the showcase, so no extra download). */
import { Image } from 'astro:assets';
import mobile from '@assets/showcase/heating-mobile.png';
import installed from '../../templates/heating/assets/demo-boiler-installed-768.webp';
import radiator from '../../templates/heating/assets/demo-radiator-1280.webp';
import underfloor from '../../templates/heating/assets/demo-underfloor-1280.webp';
import { demo } from '../../templates/heating/demo';
import { examples } from '@data/v4.js';

const b = examples.beforeAfter;
const initials = demo.business.split(/\s+/).map((w) => w[0]).join('').toLocaleUpperCase('lt');
const thumbs = [installed, radiator, underfloor];
---
<div class="ba">
  <p class="ba__line"><span>{b.from}</span> <span><span class="ba__arrow" aria-hidden="true">→</span> {b.to}</span></p>
  <div class="ba__pair">
    <figure class="ba__side">
      <figcaption class="stamp stamp--plain ba__tag">{b.beforeTag}</figcaption>
      <div class="portal" role="img" aria-label={b.portalAlt}>
        <p class="portal__top"><span>{b.portal}</span><span class="portal__demo">{b.demo}</span></p>
        <div class="portal__who">
          <span class="portal__avatar" aria-hidden="true">{initials}</span>
          <span><strong>{demo.business}</strong><small>{b.meta}</small></span>
        </div>
        <p class="portal__text">{b.text}</p>
        <ul class="portal__photos" aria-hidden="true">
          {thumbs.map((src) => <li><Image src={src} alt="" width={160} height={120} fit="cover" format="webp" quality={70} loading="lazy" decoding="async" /></li>)}
        </ul>
        <p class="portal__btn" aria-hidden="true">{b.contact}</p>
      </div>
    </figure>
    <p class="ba__to" aria-hidden="true">→</p>
    <figure class="ba__side ba__side--after">
      <figcaption class="stamp ba__tag">{b.afterTag}</figcaption>
      <div class="ba__site">
        <Image src={mobile} alt={b.siteAlt} widths={[390, 600, 780]}
          sizes="(min-width: 64rem) 17.5rem, min(17.5rem, calc(78vw - 1.5rem))"
          format="webp" quality={80} loading="lazy" decoding="async" />
      </div>
    </figure>
  </div>
  <p class="ba__note">{b.note}</p>
</div>

<style>
  .ba { display: grid; gap: clamp(1.75rem, 4vw, 2.5rem); margin-top: clamp(4rem, 9vw, 7rem); padding-top: clamp(2rem, 5vw, 3rem); border-top: 1px solid var(--rule); }
  .ba__line { margin: 0; font-size: clamp(1.75rem, 4.2vw, 3rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.04em; }
  .ba__line > span { display: block; text-wrap: balance; }
  .ba__arrow { color: var(--accent-ink); }
  .ba__pair { display: grid; gap: 1rem; justify-items: center; }
  .ba__side { display: grid; gap: 0.875rem; justify-items: start; width: min(19rem, 78vw); margin: 0; }
  .ba__tag { color: var(--ink-2); }
  .ba__side--after { width: min(15rem, 64vw); }
  .ba__to { margin: 0; font-size: 2.25rem; line-height: 1; color: var(--accent-ink); transform: rotate(90deg); }

  /* Generic portal card: grey chrome, list-like layout, deliberately plain. */
  .portal { width: 100%; display: grid; gap: 0.875rem; padding: 0 0 1rem; border: 1px solid var(--rule); border-radius: 6px; background: #fff; font-size: 0.875rem; line-height: 1.45; color: #3d3c38; overflow: hidden; }
  .portal__top { display: flex; justify-content: space-between; align-items: center; margin: 0; padding: 0.5rem 0.875rem; background: #e9e8e4; color: #5b5952; font-size: 0.75rem; }
  .portal__demo { font-family: var(--font-stamp); font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); }
  .portal__who { display: flex; gap: 0.75rem; align-items: center; padding: 0 0.875rem; }
  .portal__avatar { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: #d6d4ce; color: #4a4943; font-weight: 700; font-size: 0.875rem; }
  .portal__who strong { display: block; color: var(--ink); font-size: 1rem; }
  .portal__who small { display: block; color: #6b6962; font-size: 0.8125rem; }
  .portal__text { margin: 0; padding: 0 0.875rem; }
  .portal__photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.375rem; padding: 0 0.875rem; }
  .portal__photos :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 3px; filter: saturate(0.75); }
  .portal__btn { margin: 0 0.875rem; padding: 0.625rem; border-radius: 4px; background: #e9e8e4; color: #5b5952; text-align: center; font-weight: 600; }

  .ba__site { width: 100%; padding: 0.625rem; border-radius: 2.25rem; background: var(--ink); }
  .ba__site :global(img) { width: 100%; height: auto; border-radius: 1.625rem; aspect-ratio: 390 / 844; object-fit: cover; object-position: top; }
  .ba__note { margin: 0; color: var(--mute); font-size: 0.875rem; }

  @media (min-width: 48rem) {
    .ba__pair { grid-template-columns: minmax(0, 19rem) auto minmax(0, 19rem); justify-content: start; align-items: center; column-gap: clamp(1.5rem, 4vw, 3rem); }
    .ba__side, .ba__side--after { width: 100%; }
    .ba__to { transform: none; font-size: 3rem; }
  }
  @media (min-width: 80rem) {
    .ba { grid-template-columns: minmax(0, 1fr) auto; column-gap: 4rem; align-items: center; }
    .ba__line { font-size: 2.5rem; }
    .ba__note { grid-column: 1 / -1; }
  }
</style>
