---
import ContactButtons from './ContactButtons.astro';
import InquiryForm from './InquiryForm.astro';

interface Props { finalCta: { title: string; lead: string }; formSource: string }
const { finalCta, formSource } = Astro.props;
---
<section class="section final" id="kontaktai" aria-labelledby="final-title">
  <div class="wrap">
    <h2 id="final-title">{finalCta.title}</h2>
    <p class="final__lead">{finalCta.lead}</p>
    <ContactButtons />
    <div class="final__form">
      <InquiryForm source={formSource} />
    </div>
  </div>
</section>

<style>
  .final__lead { font-size: 1.1875rem; }
  .final__form { margin-top: 2.5rem; }
</style>
