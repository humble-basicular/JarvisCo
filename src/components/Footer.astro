---
/* v4 footer (plan §4.2 item 13): individuali veikla details, privacy, terms. */
import { brand, footer as legal } from '@data/content.js';
import { footer } from '@data/v4.js';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap ftr__grid">
    <div>
      <p class="ftr__name">{brand.name}</p>
      <p class="mute">{footer.line}</p>
    </div>
    <ul class="ftr__links">
      <li><a href={brand.telHref} data-track="cta_call">{brand.phone}</a></li>
      <li><a href={brand.smsHref} data-track="cta_sms">SMS</a></li>
      <li><a href={brand.emailHref}>{brand.email}</a></li>
      <li><a href="/rezultatai">Rezultatai</a></li>
      <li><a href={legal.privacy.href}>{legal.privacy.label}</a></li>
      <li><a href={legal.terms.href}>{legal.terms.label}</a></li>
    </ul>
  </div>
  <div class="wrap ftr__base">
    <p class="small">© {year} {footer.owner}</p>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--ink); padding-top: clamp(3rem, 6vw, 5rem); }
  .ftr__grid { display: grid; gap: 2rem; }
  .ftr__name { font-size: clamp(2rem, 6vw, 3.5rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1; margin-bottom: 0.75rem; }
  .ftr__links { display: grid; }
  .ftr__links a { display: flex; align-items: center; min-height: 3rem; border-bottom: 1px solid var(--rule); text-decoration: none; overflow-wrap: anywhere; }
  .ftr__links a:hover { text-decoration: underline; }
  .ftr__base { padding-block: 2rem 2.5rem; }
  @media (min-width: 64rem) {
    .ftr__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 4rem; }
  }
</style>
