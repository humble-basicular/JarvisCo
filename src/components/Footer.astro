---
import { brand, footer } from '@data/content.js';
---
<footer class="footer">
  <div class="wrap wrap--wide">
    <p><strong>{brand.owner}</strong> · {brand.status} · {brand.city}</p>
    <p>
      <a href={brand.emailHref}>{brand.email}</a> ·
      <a href={brand.telHref} data-track="cta_call">{brand.phone}</a>
    </p>
    <ul class="footer__links">
      <li><a href={footer.privacy.href}>{footer.privacy.label}</a></li>
      <li><a href={footer.terms.href}>{footer.terms.label}</a></li>
      <li><a href={brand.facebook} rel="noopener">Facebook</a></li>
      <li><a href={brand.instagram} rel="noopener">Instagram</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding: 2rem 0 calc(2rem + var(--bar-h)); font-size: 0.9375rem; color: var(--muted); }
  .footer p { margin-bottom: 0.5rem; }
  .footer a { display: inline-flex; align-items: center; min-height: 3rem; }
  .footer__links { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  @media (min-width: 48.0625rem) { .footer { padding-bottom: 2rem; } }
</style>
