---
/* Free-preview form, step by step (plan §4.3, funnel spec §4). One question
   per screen with JS: trade → services → area → years → photos/logo → contact.
   Posts multipart to /t/form with exactly the spec's wire fields. Trade and
   years have no wire field: their inputs belong to no form (form="pf-none"),
   and preview-form.ts writes them into `standout`. Without JS the form stays `hidden`
   (it cannot navigate to the Worker's JSON) and a noscript block offers call / SMS. */
import { funnel, footer, brand } from '@data/content.js';
import { steps as s, MAIN_CTA } from '@data/v4.js';
import { FORM_ENDPOINT, FORM_LIMITS } from '@data/tracking.js';

interface Props { trade?: string }
const { trade = '' } = Astro.props;
const f = funnel.form;
const messages = JSON.stringify({
  errors: { ...f.errors, ...s.extraErrors },
  thanks: f.thanks,
  sending: f.sending,
  preparing: f.preparing,
  progress: s.progress,
  composed: s.composed,
  channel: s.contact.channel,
  labels: { required: f.required, optional: f.optional },
});
const accept = ['image/*', ...FORM_LIMITS.extensions.filter((e) => !['jpg', 'jpeg', 'png', 'webp', 'heic', 'heif', 'gif'].includes(e)).map((e) => `.${e}`)].join(',');
const NONE = 'pf-none'; // no such form: these inputs are never submitted
---
<noscript>
  <div class="pf-nojs">
    <p class="pf-nojs__promise">{MAIN_CTA}: {s.noscriptPromise}</p>
    <div class="pf-nojs__actions">
      <a class="btn btn--accent btn--big" href={brand.telHref}>{s.noscriptCall}</a>
      <a class="btn btn--line btn--big" href={brand.smsHref}>{s.noscriptSms}</a>
    </div>
    <a class="link" href={brand.emailHref}>{brand.email}</a>
    <p class="pf__hint">{s.noscriptLine}</p>
  </div>
</noscript>
<form
  class="pf"
  hidden
  action={FORM_ENDPOINT}
  method="post"
  enctype="multipart/form-data"
  data-preview-form
  data-messages={messages}
  data-trade={trade}
  data-heating={s.trade.heating}
  aria-labelledby="forma-title"
>
  <div class="pf__progress" data-progress hidden>
    <p class="stamp stamp--plain" data-progress-text aria-live="polite"></p>
    <span class="pf__bar" aria-hidden="true"><span data-progress-bar></span></span>
  </div>

  <input type="hidden" name="code" value="" data-code />

  <fieldset class="pf__step" data-step>
    <legend class="pf__q" tabindex="-1">{s.trade.q}</legend>
    <div class="pf__chips">
      {s.trade.options.map((t, i) => (
        <span class="pf__chip pf__chip--radio">
          <input type="radio" name="trade" value={t} id={`pf-trade-${i}`} form={NONE} data-trade-input />
          <label for={`pf-trade-${i}`}>{t}</label>
        </span>
      ))}
    </div>
    <div class="pf__field pf__field--sub" data-trade-other>
      <label for="pf-trade-other">{s.trade.otherLabel} <span class="pf__opt">{f.optional}</span></label>
      <input id="pf-trade-other" type="text" maxlength="60" form={NONE} />
    </div>
  </fieldset>

  <fieldset class="pf__step" data-step>
    <legend class="pf__q" tabindex="-1">{s.services.q}</legend>
    {Object.entries(funnel.services).map(([prefix, list]) => (
      <div class="pf__checks" data-services-for={prefix}>
        {list.map((item, i) => (
          <span class="pf__check">
            <input type="checkbox" name="services" value={item} id={`pf-svc-${prefix}-${i}`} />
            <label for={`pf-svc-${prefix}-${i}`}>{item}</label>
          </span>
        ))}
      </div>
    ))}
    <div class="pf__field pf__field--sub">
      <label for="pf-services-other" data-services-label data-list={s.services.other} data-free={s.services.free}>{s.services.free} <span class="pf__opt">{f.optional}</span></label>
      <input id="pf-services-other" type="text" name="services_other" maxlength="200" placeholder={s.services.hint} aria-describedby="pf-services_other-err" />
      <p class="pf__err" id="pf-services_other-err" data-error="services_other" hidden></p>
    </div>
  </fieldset>

  <fieldset class="pf__step" data-step>
    <legend class="pf__q" tabindex="-1">{s.area.q}</legend>
    <div class="pf__chips">
      {funnel.areas.map((a, i) => (
        <span class="pf__chip">
          <input type="checkbox" name="area" value={a} id={`pf-area-${i}`} />
          <label for={`pf-area-${i}`}>{a}</label>
        </span>
      ))}
    </div>
    <div class="pf__field pf__field--sub">
      <label for="pf-area-other">{s.area.other} <span class="pf__opt">{f.optional}</span></label>
      <input id="pf-area-other" type="text" name="area_other" maxlength="200" aria-describedby="pf-area_other-err" />
      <p class="pf__err" id="pf-area_other-err" data-error="area_other" hidden></p>
    </div>
  </fieldset>

  <fieldset class="pf__step" data-step>
    <legend class="pf__q" tabindex="-1">{s.years.q}</legend>
    <div class="pf__chips">
      {s.years.options.map((y, i) => (
        <span class="pf__chip pf__chip--radio">
          <input type="radio" name="years" value={y} id={`pf-years-${i}`} form={NONE} data-years-input />
          <label for={`pf-years-${i}`}>{y} m.</label>
        </span>
      ))}
    </div>
    <div class="pf__field pf__field--sub">
      <label for="pf-standout">{s.years.standout} <span class="pf__opt">{f.optional}</span></label>
      <textarea id="pf-standout" name="standout" rows="3" maxlength="900" placeholder={s.years.standoutHint} aria-describedby="pf-standout-err"></textarea>
      <p class="pf__err" id="pf-standout-err" data-error="standout" hidden></p>
    </div>
  </fieldset>

  <fieldset class="pf__step" data-step>
    <legend class="pf__q" tabindex="-1">{s.photos.q}</legend>
    <div class="pf__radios" aria-describedby="pf-photos_ok-err">
      <span class="pf__radio"><input type="radio" name="photos_ok" value="yes" id="pf-photos-yes" /><label for="pf-photos-yes">{s.photos.yes}</label></span>
      <span class="pf__radio"><input type="radio" name="photos_ok" value="send_other" id="pf-photos-other" /><label for="pf-photos-other">{s.photos.own}</label></span>
    </div>
    <p class="pf__err" id="pf-photos_ok-err" data-error="photos_ok" hidden></p>
    <div class="pf__field pf__field--sub">
      <label for="pf-profile">{s.photos.profile} <span class="pf__opt">{f.optional}</span></label>
      <input id="pf-profile" type="text" maxlength="500" form={NONE} data-profile />
    </div>
    <div class="pf__field pf__field--sub">
      <label for="pf-files">{s.photos.files} <span class="pf__opt">{f.optional}</span></label>
      <p class="pf__hint" id="pf-files-hint">{s.photos.filesHint}</p>
      <input id="pf-files" class="pf__file" type="file" name="files" multiple accept={accept} aria-describedby="pf-files-hint pf-files-err" />
      <ul class="pf__list" data-file-list aria-live="polite"></ul>
      <p class="pf__err" id="pf-files-err" data-error="files" hidden></p>
    </div>
  </fieldset>

  <fieldset class="pf__step" data-step>
    <legend class="pf__q" tabindex="-1">{s.contact.q}</legend>
    <p class="pf__hint" data-code-note hidden>{s.contact.withCode}</p>
    <div class="pf__field">
      <label for="pf-name">{f.name} <span class="pf__opt">{f.optional}</span></label>
      <input id="pf-name" type="text" name="name" maxlength="80" autocomplete="given-name" aria-describedby="pf-name-err" />
      <p class="pf__err" id="pf-name-err" data-error="name" hidden></p>
    </div>
    <fieldset class="pf__group" data-via-group>
      <legend class="visually-hidden">{s.contact.via}</legend>
      <div class="pf__radios">
        <span class="pf__radio"><input type="radio" name="preview_via" value="sms" id="pf-via-sms" checked /><label for="pf-via-sms">{s.contact.sms}</label></span>
        <span class="pf__radio"><input type="radio" name="preview_via" value="email" id="pf-via-email" /><label for="pf-via-email">{s.contact.email}</label></span>
      </div>
    </fieldset>
    <div class="pf__field" data-phone-field>
      <label for="pf-phone">{f.phone} <span class="pf__opt" data-phone-opt>{f.required}</span></label>
      <p class="pf__hint" id="pf-phone-hint" data-phone-hint data-sms={f.phoneHint} data-email={s.contact.phoneOptionalHint}>{f.phoneHint}</p>
      <input
        id="pf-phone"
        type="tel"
        name="phone"
        required
        maxlength="20"
        inputmode="tel"
        autocomplete="tel"
        pattern={String.raw`[0-9 +\-\(\)]{8,20}`}
        placeholder="+370 6xx xxxxx"
        aria-describedby="pf-phone-hint pf-phone-err"
      />
      <p class="pf__err" id="pf-phone-err" data-error="phone" hidden></p>
    </div>
    <div class="pf__field" data-email-field hidden>
      <label for="pf-email">{s.contact.emailLabel} <span class="pf__opt">{f.required}</span></label>
      <p class="pf__hint" id="pf-email-hint">{s.contact.emailHint}</p>
      <input
        id="pf-email"
        type="email"
        name="email"
        maxlength="254"
        inputmode="email"
        autocomplete="email"
        autocapitalize="none"
        spellcheck="false"
        placeholder="vardas@pastas.lt"
        disabled
        aria-describedby="pf-email-hint pf-email-err"
      />
      <p class="pf__err" id="pf-email-err" data-error="email" hidden></p>
    </div>
    <fieldset class="pf__group" aria-describedby="pf-contact_time-err">
      <legend>{f.time} <span class="pf__opt">{f.optional}</span></legend>
      <div class="pf__radios">
        {f.times.map((t) => (
          <span class="pf__radio"><input type="radio" name="contact_time" value={t.value} id={`pf-time-${t.value}`} /><label for={`pf-time-${t.value}`}>{t.label}</label></span>
        ))}
      </div>
      <p class="pf__err" id="pf-contact_time-err" data-error="contact_time" hidden></p>
    </fieldset>

    <div class="pf__hp" aria-hidden="true">
      <label for="pf-website">Svetainė</label>
      <input id="pf-website" type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <p class="pf__consent">{s.consent} <a href={footer.privacy.href}>{footer.privacy.label}</a>.</p>
    <p class="pf__hint pf__callnote">{s.callbackNote}</p>
    <div class="pf__send">
      <button class="btn btn--accent btn--big" type="submit" name="kind" value="preview_request">{MAIN_CTA}</button>
      <button class="btn btn--line btn--big" type="submit" name="kind" value="callback_request">{s.callback}</button>
    </div>
  </fieldset>

  <div class="pf__nav" data-step-nav hidden>
    <button class="btn btn--line" type="button" data-back>{s.back}</button>
    <button class="btn btn--ink" type="button" data-next>{s.next}</button>
  </div>

  <p class="pf__status" data-status role="status" aria-live="polite"></p>
</form>

<div class="pf-thanks" data-thanks hidden tabindex="-1">
  <p class="stamp">Gauta</p>
  <p class="pf-thanks__text" data-thanks-text></p>
  <p class="pf-thanks__sign">{f.thanks.sign}</p>
</div>

<script>
  import '../../scripts/preview-form';
</script>

<style>
  .pf { color-scheme: light; }
  .pf-nojs { display: grid; gap: 1rem; padding-block: 1.5rem; }
  .pf-nojs__promise { margin: 0; font-size: 1.25rem; font-weight: 600; line-height: 1.2; }
  .pf-nojs__actions { display: grid; gap: 0.75rem; }
  @media (min-width: 48rem) { .pf-nojs__actions { grid-template-columns: auto auto; justify-content: start; } }
  .pf__progress { display: grid; gap: 0.625rem; margin-bottom: 1.5rem; }
  .pf__progress .stamp { color: var(--mute); }
  .pf__bar { display: block; height: 2px; background: var(--rule); }
  .pf__bar span { display: block; height: 100%; width: var(--p, 0%); background: var(--ink); transition: width 0.3s var(--ease); }
  .pf__step { border: 0; padding: 0; margin: 0 0 2.5rem; min-width: 0; }
  :global(html.js) .pf.is-stepped .pf__step { min-height: min(26rem, 55svh); margin-bottom: 1.5rem; }
  .pf__q { display: block; padding: 0; margin-bottom: 1.25rem; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.04em; }
  .pf__q:focus { outline: none; }
  .pf__group { border: 0; padding: 0; margin: 0 0 1.5rem; min-width: 0; }
  .pf__group legend, .pf__field > label { display: block; padding: 0; font-weight: 600; margin-bottom: 0.625rem; }
  .pf__field { margin-bottom: 1.5rem; }
  .pf__field--sub { margin-top: 1.5rem; }
  .pf__opt { font-weight: 400; color: var(--mute); font-size: 0.9375rem; }
  .pf input[type='text'], .pf input[type='tel'], .pf input[type='email'], .pf textarea {
    width: 100%; min-height: 3.5rem; padding: 0.75rem 0.875rem;
    color: var(--ink); background: #fff; border: 1px solid var(--ink); border-radius: 4px;
  }
  .pf textarea { resize: vertical; }
  .pf input:focus-visible, .pf textarea:focus-visible { outline: 3px solid var(--focus); outline-offset: 1px; }
  .pf [aria-invalid='true'] { border-color: var(--err) !important; box-shadow: inset 0 0 0 1px var(--err); }
  .pf__hint { color: var(--mute); font-size: 0.9375rem; margin: -0.25rem 0 0.625rem; }

  /* Chips, checks and radios: the whole label is the tap target (≥ 48 px). */
  .pf__checks { display: grid; gap: 0.5rem; }
  :global(html.js) .pf__checks:not(.is-on) { display: none; }
  .pf__chips, .pf__radios { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pf__chip, .pf__radio, .pf__check { position: relative; display: inline-flex; }
  .pf__check { display: flex; }
  .pf__chip input, .pf__radio input, .pf__check input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .pf__chip label, .pf__radio label, .pf__check label {
    display: inline-flex; align-items: center; gap: 0.625rem; width: 100%; min-height: 3rem; padding: 0.5rem 1rem;
    border: 1px solid var(--ink); border-radius: 4px; background: #fff; font-weight: 500; cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .pf__check label::before, .pf__chip label::before { content: ''; flex: none; width: 1rem; height: 1rem; border: 1.5px solid currentColor; border-radius: 2px; }
  .pf__radio label::before, .pf__chip--radio label::before { content: ''; flex: none; width: 1rem; height: 1rem; border: 1.5px solid currentColor; border-radius: 50%; }
  .pf input:checked + label { background: var(--ink); color: var(--paper); }
  .pf input:checked + label::before { background: var(--accent); border-color: var(--accent); }
  .pf input:focus-visible + label { outline: 3px solid var(--focus); outline-offset: 2px; }
  .pf [data-invalid] label { border-color: var(--err); }
  :global(html.js) .pf [data-trade-other]:not(.is-on) { display: none; }

  .pf__file { width: 100%; min-height: 3.5rem; padding: 0.625rem; border: 1px dashed var(--ink); border-radius: 4px; background: #fff; }
  .pf__file::file-selector-button { margin-right: 0.75rem; min-height: 2.5rem; padding: 0.375rem 0.875rem; border: 0; border-radius: 4px; background: var(--ink); color: var(--paper); font: inherit; font-weight: 600; cursor: pointer; }
  .pf__list { display: grid; gap: 0.25rem; margin-top: 0.625rem; font-size: 0.9375rem; color: var(--mute); }
  .pf__list li { overflow-wrap: anywhere; }
  .pf__list:empty { display: none; }
  .pf__err { color: var(--err); font-weight: 600; font-size: 0.9375rem; margin: 0.5rem 0 0; }

  .pf__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .pf__consent { font-size: 0.9375rem; color: var(--ink-2); max-width: 36rem; }
  .pf__consent a { display: inline-flex; align-items: center; min-height: 3rem; margin-block: -0.875rem; }
  .pf__send { display: grid; gap: 0.5rem; margin-top: 1.25rem; }
  .pf__send .btn:disabled, .pf__nav .btn:disabled { opacity: 0.6; cursor: wait; }
  .pf__nav { display: flex; justify-content: space-between; gap: 0.75rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .pf__nav .btn { flex: 1; max-width: 14rem; }
  .pf__nav [data-next] { margin-left: auto; }
  .pf__status { margin: 1rem 0 0; font-weight: 600; }
  .pf__status:empty { display: none; }
  .pf__status.is-err { color: var(--err); }
  @media (min-width: 48rem) {
    .pf__send { grid-template-columns: auto auto; justify-content: start; }
  }

  .pf-thanks { padding-block: 2rem; border-top: 1px solid var(--ink); }
  .pf-thanks:focus { outline: none; }
  .pf-thanks__text { font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.035em; margin: 1rem 0; max-width: 22ch; }
  .pf-thanks__sign { margin: 0; font-weight: 600; color: var(--mute); }
</style>
