---
/* One layout for every offer page: `/` and each niche (`/arboristams`, …).
   Section order follows spec §3.1. A page passes one entry from content.js. */
import Layout from '@layouts/Layout.astro';
import Hero from './Hero.astro';
import Proof from './Proof.astro';
import Offer from './Offer.astro';
import Steps from './Steps.astro';
import About from './About.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';

interface Props { page: any }
const { page } = Astro.props;
---
<Layout title={page.meta.title} description={page.meta.description} ogImage={page.meta.ogImage} faq={page.faq}>
  <Hero hero={page.hero} />
  <Proof proof={page.proof} />
  {page.audience && (
    <section class="section" aria-labelledby="audience-title">
      <div class="wrap">
        <h2 id="audience-title">{page.audience.title}</h2>
        <p>{page.audience.text}</p>
      </div>
    </section>
  )}
  <Offer />
  <Steps />
  <About />
  <Faq items={page.faq} />
  <FinalCta finalCta={page.finalCta} formSource={page.formSource} />
</Layout>
