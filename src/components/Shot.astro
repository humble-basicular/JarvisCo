---
/* A proof thumbnail that links to the full screenshot. With JS, zoom.ts opens
   it in the dialog; without JS the link opens the image. */
import { Image } from 'astro:assets';
import type { ResolvedShot } from '@data/proof-images';
import { arbcutProof } from '@data/content.js';

interface Props {
  shot: ResolvedShot;
  sizes?: string;
  class?: string;
  label?: string;
  eager?: boolean;
}
const { shot, sizes = '(min-width: 64rem) 30rem, calc(100vw - 3rem)', class: cls, label = arbcutProof.viewLabel, eager = false } = Astro.props;
const widths = [360, 720, 1080].filter((w) => w < shot.card.width).concat(shot.card.width);
---
<a
  href={shot.href}
  class:list={['shot', cls]}
  data-zoom
  data-w={shot.w}
  data-h={shot.h}
  data-alt={shot.alt}
  data-caption={shot.caption}
  aria-label={`${arbcutProof.zoomLabel}: ${shot.caption}`}
>
  <Image src={shot.card} alt={shot.alt} widths={widths} sizes={sizes} quality={80} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  <span class="shot__pill" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5M11 8v6M8 11h6"/></svg>
    <span class="shot__label">{label}</span>
  </span>
</a>

<style>
  .shot {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(13, 26, 19, 0.1), 0 18px 40px -22px rgba(6, 17, 12, 0.55);
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: left top; transition: transform 0.6s var(--ease); }
  .shot:hover { box-shadow: 0 0 0 1px rgba(13, 26, 19, 0.14), 0 26px 50px -22px rgba(6, 17, 12, 0.6); }
  .shot:hover :global(img) { transform: scale(1.03); }
  .shot__pill {
    /* Top-right, as in the concept: the evidence (tooltips, KPI tiles) sits low in the crops. */
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0 0.75rem 0 0.625rem;
    border-radius: 999px;
    background: rgba(6, 17, 12, 0.86);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .shot__pill svg { width: 1rem; height: 1rem; }
</style>
