---
/* Mobile-only (< 768 px) bottom bar with the two actions. Without JS it is
   always shown; with JS it shows only while neither the hero buttons nor the
   contact buttons is on screen. */
import { brand, cta } from '@data/content.js';
---
<nav class="bar" aria-label={cta.contact} data-sticky-bar>
  <a class="btn btn--lime" href={brand.smsHref} data-track="cta_sms">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z"/></svg>
    {cta.sms}
  </a>
  <a class="btn btn--ghost" href={brand.telHref} data-track="cta_call">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    {cta.call}
  </a>
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
  const targets = document.querySelectorAll('[data-hero-cta], [data-contact-cta]');
  if (bar && targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visible.add(e.target);
        else visible.delete(e.target);
      }
      bar.classList.toggle('is-shown', visible.size === 0);
    });
    targets.forEach((t) => io.observe(t));
  } else {
    bar?.classList.add('is-shown');
  }
</script>

<style>
  .bar {
    position: fixed;
    left: 0.625rem;
    right: 0.625rem;
    bottom: calc(0.625rem + env(safe-area-inset-bottom));
    z-index: 50;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 0.5rem;
    padding: 0.4375rem;
    border-radius: 22px;
    background: rgba(6, 17, 12, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.7);
    transition: transform 0.35s var(--ease), opacity 0.35s, visibility 0.35s;
    view-transition-name: sticky-bar;
  }
  :global(html.js) .bar:not(.is-shown) { transform: translateY(130%); opacity: 0; visibility: hidden; }
  .bar .btn { min-height: 3.25rem; padding: 0.5rem 0.75rem; border-radius: 16px; }
  .bar .btn svg { width: 1.125rem; height: 1.125rem; }
  @media (min-width: 48rem) { .bar { display: none; } }
</style>
