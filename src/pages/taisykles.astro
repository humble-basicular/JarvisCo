---
import LegalPage from '@components/LegalPage.astro';
import { brand, offer } from '@data/content.js';
import { O2_OFFER } from '@data/o2.js';
---
<LegalPage title="Taisyklės" description="Svetainės jarvisweb.lt naudojimo taisyklės ir pasiūlymo sąlygos." updated="2026-11-08">
  <h2>Kas teikia paslaugą</h2>
  <p>
    {brand.owner}, {brand.status.toLowerCase()}, {brand.city}. El. paštas
    <a href={brand.emailHref}>{brand.email}</a>, tel. <a href={brand.telHref}>{brand.phone}</a>.
  </p>

  <h2>Jarvis Systems pilnas paketas</h2>
  <p>Pilno paketo kaina – {O2_OFFER.monthly} Į šią kainą įeina:</p>
  <ul>{O2_OFFER.includes.map((item) => <li>{item}</li>)}</ul>
  <p>{O2_OFFER.guarantee}.</p>
  <p>{O2_OFFER.guaranteeDetails}</p>
  <p>Tikslią darbų apimtį ir įgyvendinimo sąlygas nurodome raštu prieš mokėjimą.</p>

  <h2>Anksčiau sutarti pasiūlymai</h2>
  <p>Anksčiau atskirai sutartoms paslaugoms taikomos su Jumis raštu suderintos sąlygos.</p>

  <h2>Rezultatai</h2>
  <p>
    Svetainėje rodomi vieno kliento (arbcut.lt) rezultatai su originaliomis ekrano kopijomis. Tai nėra
    pažadas ar garantija, kad kita svetainė gaus tiek pat užklausų ar paspaudimų.
  </p>

  <h2>Nuosavybė</h2>
  <p>{offer.ownership}</p>

  <h2>Klausimai</h2>
  <p>Klausimus ir pastabas siųskite <a href={brand.emailHref}>{brand.email}</a>.</p>
</LegalPage>
