---
/* Lead previews (funnel spec §8): one page per previews/<slug>.json written by
   `npm run preview -- <input.json>`. The slug is random, so pages are not
   guessable; they are noindex,nofollow and kept out of the sitemap. */
import type { GetStaticPaths } from 'astro';
import PreviewLayout from '@layouts/PreviewLayout.astro';
import PreviewSite from '@components/preview/PreviewSite.astro';
import type { PreviewData } from '@data/preview';

export const getStaticPaths = (() => {
  const files = import.meta.glob<{ default: PreviewData }>('../../../previews/*.json', { eager: true });
  return Object.values(files).map(({ default: data }) => ({ params: { slug: data.slug }, props: { data } }));
}) satisfies GetStaticPaths;

const { data } = Astro.props;
---
<PreviewLayout title={`${data.business} – peržiūra`} description={`${data.business}: svetainės peržiūra.`}>
  <PreviewSite data={data} />
</PreviewLayout>
