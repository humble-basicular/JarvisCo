---
/* 404 in the Jarvis Systems O2 shell; the old Layout linked the dead free-preview form (audit 2026-11-16, 75d538b2 #3). */
import O2Layout from '@layouts/O2Layout.astro';
import { utility } from '@data/content.js';
import { O2_CTA } from '@data/o2.js';
---
<O2Layout title={utility.notFound.metaTitle} description={utility.notFound.title} path="/404" noindex>
  <section class="missing">
    <p class="missing__code">404</p>
    <h1>{utility.notFound.title}</h1>
    <p>{utility.notFound.text}</p>
    <p class="missing__ctas">
      <a class="btn" href="/">{utility.home}</a>
      <a href="/registracija" data-track="cta_book">{O2_CTA}</a>
    </p>
  </section>
</O2Layout>
<style>
  .missing { display: grid; gap: 1.25rem; justify-items: start; align-content: start; max-width: 52rem; margin: 0 auto; padding: clamp(4rem, 12vw, 9rem) 16px; min-height: 60svh; color: var(--navy); }
  .missing h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.2; font-weight: 700; margin: 0; }
  .missing__code { font-weight: 700; color: var(--gold-ink); margin: 0; }
  .missing__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .missing__ctas a:not(.btn) { color: var(--navy); font-weight: 600; }
</style>
