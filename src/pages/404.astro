---
import Layout from '@layouts/Layout.astro';
import { utility } from '@data/content.js';
import { MAIN_CTA } from '@data/v4.js';
---
<Layout title={utility.notFound.metaTitle} description={utility.notFound.title} noindex>
  <section class="wrap missing">
    <p class="stamp">404</p>
    <h1 class="head__title">{utility.notFound.title}</h1>
    <p class="head__text">{utility.notFound.text}</p>
    <p class="missing__ctas">
      <a class="btn btn--ink" href="/">{utility.home}</a>
      <a class="link" href="/#forma">{MAIN_CTA}</a>
    </p>
  </section>
</Layout>
<style>
  .missing { display: grid; gap: 1.5rem; justify-items: start; padding-block: clamp(4rem, 12vw, 9rem); min-height: 60svh; }
  .missing__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
</style>
