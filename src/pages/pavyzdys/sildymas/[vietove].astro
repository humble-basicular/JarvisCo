---
/* Demo town (GEO) pages of the heating example: /pavyzdys/sildymas/<vietove>. Template v3 with the
   town block; same images and theme as the demo homepage. noindex + PAVYZDYS like the homepage. */
import V3Layout from '../../../templates/v3/V3Layout.astro';
import V3Site from '../../../templates/v3/V3Site.astro';
import { site, v3 } from '../../../templates/v3/demo';
import { DEMO_PATH, townLinks, townPage, townSlugs } from '../../../templates/heating/towns';

export function getStaticPaths() {
  return townSlugs().map((vietove) => ({ params: { vietove } }));
}
const { town, data } = townPage(Astro.params.vietove!);
const page = { ...site, city: data.city, areas: data.areas, lead: data.lead, prices: data.prices, faq: [...town.faq, ...site.faq].slice(0, 6) };
const banner = { tag: 'PAVYZDYS', note: 'Šildymo meistro svetainės pavyzdys. Įmonė ir duomenys išgalvoti.', href: DEMO_PATH, label: '← Pavyzdžio pradžia' };
---
<V3Layout title={town.title} description={town.description} theme={v3.theme} banner={banner}>
  <V3Site data={page} v3={v3} towns={townLinks()} base="Kaunas" town={town} home={DEMO_PATH} demo />
</V3Layout>
