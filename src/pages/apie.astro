---
/* /apie — Stone "About": centred heading on grey; text column + own mascot (no team photos, no history we lack). */
import O2Layout from '@layouts/O2Layout.astro';
import PageHead from '@components/o2/PageHead.astro';
import Talk from '@components/o2/Talk.astro';
import { Image } from 'astro:assets';
import { pages } from '@data/o2-pages.js';
import { O2_CTA } from '@data/o2.js';
import matas from '../assets/people/matas.webp';
const P = pages.apie;
---
<O2Layout title={P.title} description={P.description} path="/apie">
  <PageHead title={P.h} flat>
    <div class="about">
      <div class="about__txt">
        {P.paras.map((t) => <p>{t}</p>)}
        <dl class="about__facts">{P.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        <p class="about__acts"><a class="btn" href="/kontaktai" data-book-open data-track="cta_book">{O2_CTA}</a><a class="btn btn--ghost" href="/musu-darbai">Mūsų darbai</a></p>
      </div>
      <figure class="about__photo">
        <Image src={matas} width={720} alt="Matas Bašinskas prie darbo stalo su kompiuteriais" format="webp" quality={82} loading="eager" />
        <img class="about__mascot" src="/jarvis-systems/mascot-arms-crossed.webp" width="700" height="1050" alt="" loading="lazy" />
        <figcaption>Matas Bašinskas · Kaunas</figcaption>
      </figure>
    </div>
  </PageHead>
  <Talk />
</O2Layout>
