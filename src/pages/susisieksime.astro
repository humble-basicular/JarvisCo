---
/* /susisieksime — copy of Stone's grow.stonesystems.io/we-will-call-you (checked 2026-11-12), shown after the quiz:
   label, headline + price, step 1 = short video with sound, next = we call you (no calendar), proof cards.
   Stone's video is Kai (56 s); ours is VIDEOS.pokalbis. Name and preview flag come from the query string set by
   src/scripts/o2.ts (v=<name>, p=1 in preview builds). noindex. */
import O2Layout from '@layouts/O2Layout.astro';
import YtFacade from '@components/o2/YtFacade.astro';
import FunnelProof from '@components/o2/FunnelProof.astro';
import Icon from '@components/o2/Icon.astro';
import { VIDEOS } from '@data/o2-videos.js';
import { O2_OFFER } from '@data/o2.js';
import { brand } from '@data/content.js';
---
<O2Layout title="Ačiū – paskambinsime Jums | Jarvis Systems" description="Registracija pokalbiui gauta. Paskambinsime Jums patys." path="/susisieksime" noindex funnel>
  <section class="fnl__top">
    <p class="cb__ok"><Icon name="badge" size={22} /> <span data-cb-status>Ačiū<span data-cb-name></span>! Registracija gauta</span></p>
    <p class="fnl__kicker">Meistrams</p>
    <h1 class="fnl__h">Kaip su AI ir funkcionalia svetaine padedame meistrams augti – tik už</h1>
    <p class="fnl__price fnl__price--blue">{O2_OFFER.monthly}</p>
    <p class="fnl__steps"><b>1 žingsnis:</b> pažiūrėkite šį <u>trumpą video</u> (įjunkite garsą).<br /><b>Toliau:</b> susisieksime su Jumis patys – kalendoriuje rinktis laiko nereikia.</p>
    <YtFacade video={VIDEOS.pokalbis} class="fnl__vid" />
  </section>
  <FunnelProof />
  <p class="cb__call">Norite greičiau? Skambinkite: <a href={brand.telHref} data-track="cta_call">{brand.phone}</a></p>
</O2Layout>
<script>
  const q = new URLSearchParams(location.search);
  const name = (q.get('v') ?? '').trim().slice(0, 60);
  const n = document.querySelector('[data-cb-name]'); if (n && name) n.textContent = `, ${name}`;
  if (q.get('p') === '1') { const s = document.querySelector('[data-cb-status]'); if (s) s.textContent = 'Peržiūra – registracija neišsiųsta'; }
</script>
