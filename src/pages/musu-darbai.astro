---
/* /musu-darbai — Stone "Our work": two case studies with real proof screenshots (Betono, ArbCut only),
   then every site we built (live client domains + client previews) as desktop + phone captures.
   Screenshots open in a lightbox (src/scripts/zoom.ts; without JS the link opens the image). Figures and their sources: src/data/o2-pages.js (pages.darbai) and src/assets/proof/PROVENANCE.md. */
import { Image, getImage } from 'astro:assets';
import O2Layout from '@layouts/O2Layout.astro';
import PageHead from '@components/o2/PageHead.astro';
import Talk from '@components/o2/Talk.astro';
import Icon from '@components/o2/Icon.astro';
import { pages } from '@data/o2-pages.js';
import { proofImage } from '@data/proof-images';
const P = pages.darbai;
const W = '/jarvis-systems/work/sites';
const host = (u: string) => u.replace(/^https:\/\/(www\.)?|\/$/g, '');

const shot = async ([name, caption]: [string, string]) => {
  const src = proofImage(name);
  const full = await getImage({ src, width: Math.min(src.width, 1600), format: 'webp', quality: 90 });
  return { src, href: full.src, w: Number(full.attributes.width), h: Number(full.attributes.height), caption };
};
const items = await Promise.all(P.items.map(async (w) => ({
  ...w,
  gsc: await shot(w.gsc),
  forms: w.forms ? await shot(w.forms) : null,
})));
---
<O2Layout title={P.title} description={P.description} path="/musu-darbai">
  <PageHead title={P.h} flat>
    <ul class="case">
      {items.map((w) => (
        <li class="case__it">
          <div class="case__head">
            <div class="case__intro">
              <h2>{w.name}</h2>
              <a class="work__site" href={w.url} target="_blank" rel="noopener">{w.site} <Icon name="arrow" size={16} /></a>
              <p>{w.text}</p>
            </div>
            <dl class="case__nums">{w.nums.map(([n, t]) => <div><dt>{n}</dt><dd>{t}</dd></div>)}</dl>
          </div>
          <div class="case__body">
            <figure class="case__gsc">
              <a href={w.gsc.href} data-zoom data-w={w.gsc.w} data-h={w.gsc.h} data-alt={`${w.gsc.caption}: ${w.site}`} data-caption={`${w.gsc.caption} – ${w.site}`} aria-label={`Padidinti: ${w.gsc.caption} – ${w.site}`}><Image src={w.gsc.src} width={900} alt={`${w.gsc.caption}: ${w.site}`} format="webp" quality={90} loading="lazy" /></a>
              <figcaption>{w.gsc.caption}</figcaption>
            </figure>
            <div class="case__side">
              <div class="case__media" aria-hidden="true">
                <img class="case__desk" src={`${W}/${w.shot}-desktop.webp`} width="960" height="600" alt="" loading="lazy" />
                <img class="case__phone" src={`${W}/${w.shot}-mobile.webp`} width="390" height="844" alt="" loading="lazy" />
              </div>
              {w.forms && (
                <figure class="case__forms">
                  <a href={w.forms.href} data-zoom data-w={w.forms.w} data-h={w.forms.h} data-alt={`${w.forms.caption}: 31`} data-caption={`${w.forms.caption} – ${w.site}`} aria-label={`Padidinti: ${w.forms.caption} – ${w.site}`}><Image src={w.forms.src} width={262} alt={`${w.forms.caption}: 31`} format="webp" quality={90} loading="lazy" /></a>
                  <figcaption>{w.forms.caption}</figcaption>
                </figure>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <h2 class="work__live-h" id="visos">{P.allTitle}</h2>
    <p class="work__live-p">{P.allLead}</p>
    <ul class="sites">
      {P.all.map(([name, what, url, shot, kind]) => (
        <li><a href={url} target="_blank" rel="noopener">
          <span class="sites__media">
            <img class="sites__desk" src={`${W}/${shot}-desktop.webp`} width="960" height="600" alt={`${name} – svetainė kompiuteryje`} loading="lazy" />
            <img class="sites__phone" src={`${W}/${shot}-mobile.webp`} width="390" height="844" alt={`${name} – svetainė telefone`} loading="lazy" />
            <span class={`sites__tag sites__tag--${kind}`}>{P.status[kind]}</span>
          </span>
          <span class="sites__txt"><strong>{name}</strong><span>{what}</span><span class="work__site">{host(url)} <Icon name="arrow" size={16} /></span></span>
        </a></li>
      ))}
    </ul>
  </PageHead>
  <Talk />
  <dialog class="o2zoom" data-zoom-dialog aria-labelledby="zoom-caption">
    <form method="dialog" class="o2zoom__bar">
      <p class="o2zoom__cap" id="zoom-caption" data-zoom-caption>Ekrano nuotrauka</p>
      <button class="menu__x" type="submit" aria-label="Uždaryti"><Icon name="x" size={28} /></button>
    </form>
    <div class="zoom__stage o2zoom__stage"><img alt="" decoding="async" /></div>
  </dialog>
</O2Layout>
<script>
  import '../scripts/zoom';
</script>
