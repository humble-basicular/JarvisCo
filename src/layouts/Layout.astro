---
import '../styles/global.css';
import { brand, utility } from '@data/content.js';
import { header as headerText, price } from '@data/v4.js';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
// Self-hosted fonts (fontsource, OFL): latin + latin-ext only. Lithuanian
// letters (ąčęėįšųūž) live in latin-ext, so both subsets are preloaded for the
// grotesk. The condensed stamp face is small text: swap without preload.
import sansLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import sansExt from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-ext-wght-normal.woff2?url';
import stampLatin from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';
import stampExt from '@fontsource/barlow-condensed/files/barlow-condensed-latin-ext-800-normal.woff2?url';

interface NavItem { label: string; href: string }
interface Props {
  title: string;
  description: string;
  nav?: NavItem[];
  faq?: { q: string; a: string }[];
  noindex?: boolean;
  /** Canonical path when this page duplicates another one (/noriu → /sildymui). */
  canonicalPath?: string;
  ogImage?: string;
  /** Where "Gauti nemokamą peržiūrą" leads: '#forma' on pages with the form. */
  formHref?: string;
  /** Kept for older callers; the v4 design has no sticky bar. */
  stickyBar?: boolean;
}
const { title, description, nav = headerText.nav.map((i) => ({ ...i, href: `/${i.href}` })), faq = [], noindex = false, canonicalPath, formHref, ogImage: ogPath = '/assets/og-v4.png' } = Astro.props;
const canonical = new URL(canonicalPath ?? (Astro.url.pathname.replace(/\/$/, '') || '/'), brand.url).href;
// Vercel preview builds point the share card at the preview itself, so a shared
// preview link shows the card that will go live (canonical stays jarvisweb.lt).
const shareBase = process.env.VERCEL_ENV === 'preview' && process.env.VERCEL_URL ? `https://${process.env.VERCEL_URL}` : brand.url;
const ogImage = new URL(ogPath, shareBase).href;

// Cloudflare Web Analytics (cookieless). Set PUBLIC_CF_ANALYTICS_TOKEN at build
// time, or enable the automatic setup in Cloudflare; empty = no script.
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const face = (family: string, src: string, range: string, weight: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${src}) format('woff2');unicode-range:${range}}`;
const fontCss = [
  face('Instrument Sans Variable', sansLatin, LATIN, '400 700'),
  face('Instrument Sans Variable', sansExt, EXT, '400 700'),
  face('Barlow Condensed', stampLatin, LATIN, '800'),
  face('Barlow Condensed', stampExt, EXT, '800'),
  // Metric-matched local fallback so text does not re-wrap when the grotesk swaps in.
  "@font-face{font-family:'Instrument Fallback';src:local('Arial'),local('ArialMT'),local('Helvetica Neue'),local('Roboto');size-adjust:96%;ascent-override:96%;descent-override:25%;line-gap-override:0%}",
].join('');

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${brand.url}/#business`,
  name: brand.name,
  url: brand.url,
  telephone: brand.phone,
  email: brand.email,
  founder: { '@type': 'Person', name: brand.owner },
  areaServed: { '@type': 'Country', name: 'Lietuva' },
  address: { '@type': 'PostalAddress', addressLocality: brand.city, addressCountry: 'LT' },
  sameAs: [brand.gbp, brand.facebook, brand.instagram],
  makesOffer: {
    '@type': 'Offer',
    name: 'Svetainė paslaugų meistrui',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '49', priceCurrency: 'EUR', unitCode: 'MON' },
    description: price.includes.join('; '),
  },
};
const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((it) => ({ '@type': 'Question', name: it.q, acceptedAnswer: { '@type': 'Answer', text: it.a } })),
    }
  : null;
---
<!doctype html>
<html lang="lt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#faf9f6" />

    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansExt} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>

    <meta property="og:site_name" content="jarvisweb.lt" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="lt_LT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/brand/v4/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {cfToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">{utility.skip}</a>
    <div class="progress" aria-hidden="true"><span data-scroll-line></span></div>
    <Header nav={nav} formHref={formHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/track';
      import '../scripts/motion';
    </script>
  </body>
</html>
